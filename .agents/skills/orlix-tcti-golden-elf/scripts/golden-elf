#!/usr/bin/env sh
set -eu
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cmd="${1:-list}"
case "$cmd" in
  list)
    find "$root/OrlixKernel/Tests/TCTI/golden_elf" -mindepth 1 -maxdepth 1 -type d -print | sed "s#^$root/##" | sort
    ;;
  validate)
    case_id="${2:?case id required}"
    exec make tcti-golden-elf CASE="$case_id"
    ;;
  execute)
    case_id="${2:?case id required}"
    exec make tcti-golden-elf CASE="$case_id" EXECUTE=switch-debug
    ;;
  *)
    printf '%s\n' "usage: $0 [list|validate <case>|execute <case>]" >&2
    exit 2
    ;;
esac
