#!/usr/bin/env sh
set -eu

root="$(cd "$(dirname "$0")/../../../.." && pwd)"
envelope="$root/Build/AgentHarness/orlix-tcti/next-task.json"
status_json="$root/Build/AgentHarness/orlix-tcti/status.json"

DRY_RUN="${DRY_RUN:-0}"
MAX_ITERATIONS="${MAX_ITERATIONS:-25}"
MAX_COMMANDS="${MAX_COMMANDS:-25}"
STOP_ON_TRACKED_CHANGES="${STOP_ON_TRACKED_CHANGES:-1}"
STREAM_OUTPUT="${ORLIX_TCTI_GOAL_STREAM_OUTPUT:-0}"
goal_run_id="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
goal_log_dir="$root/Build/AgentHarness/orlix-tcti/goal-loop/$goal_run_id"
refresh_log=""

mkdir -p "$goal_log_dir"

case "$MAX_ITERATIONS" in
  ''|*[!0-9]*)
    printf '%s\n' "MAX_ITERATIONS must be a non-negative integer" >&2
    exit 2
    ;;
esac

case "$MAX_COMMANDS" in
  ''|*[!0-9]*)
    printf '%s\n' "MAX_COMMANDS must be a non-negative integer" >&2
    exit 2
    ;;
esac

if ! command -v jq >/dev/null 2>&1; then
  printf '%s\n' "jq required for agent-goal" >&2
  exit 2
fi

current_head="$(cd "$root" && git rev-parse HEAD)"
initial_tracked_status="$(cd "$root" && git status --porcelain --untracked-files=no)"

iteration_count=0
command_count=0
last_selected_gate=""
last_selected_command=""
last_classification=""
last_required_next_action=""
last_runtime_patch_allowed="false"
last_harness_patch_allowed="false"
last_continue_refresh_allowed="false"
last_must_stop="false"
last_owning_layer=""
last_reason=""
last_command_log=""
refresh_count=0

json_string() {
  file="$1"
  expression="$2"
  fallback="$3"
  value="$(jq -er "$expression // empty" "$file" 2>/dev/null || true)"
  if test -n "$value"; then
    printf '%s\n' "$value"
  else
    printf '%s\n' "$fallback"
  fi
}

json_bool() {
  file="$1"
  expression="$2"
  if jq -e "($expression) == true" "$file" >/dev/null 2>&1; then
    printf '%s\n' "true"
  else
    printf '%s\n' "false"
  fi
}

refresh_envelope() {
  refresh_status=0
  if test "$STREAM_OUTPUT" = "1"; then
    (cd "$root" && ORLIX_TCTI_HARNESS_QUIET=1 rtk proxy make agent-status AREA=orlix-tcti) || refresh_status=1
    (cd "$root" && ORLIX_TCTI_HARNESS_QUIET=1 rtk proxy make agent-next AREA=orlix-tcti) || refresh_status=1
    (cd "$root" && rtk proxy make agent-task-envelope-check AREA=orlix-tcti) || refresh_status=1
  else
    refresh_count=$((refresh_count + 1))
    refresh_log="$goal_log_dir/refresh-$(printf '%03d' "$refresh_count").log"
    : >"$refresh_log"
    (cd "$root" && ORLIX_TCTI_HARNESS_QUIET=1 rtk proxy make agent-status AREA=orlix-tcti) >>"$refresh_log" 2>&1 || refresh_status=1
    (cd "$root" && ORLIX_TCTI_HARNESS_QUIET=1 rtk proxy make agent-next AREA=orlix-tcti) >>"$refresh_log" 2>&1 || refresh_status=1
    (cd "$root" && rtk proxy make agent-task-envelope-check AREA=orlix-tcti) >>"$refresh_log" 2>&1 || refresh_status=1
  fi
  return "$refresh_status"
}

load_envelope_fields() {
  if ! test -f "$envelope"; then
    printf '%s\n' "missing next-task envelope: $envelope" >&2
    return 1
  fi

  last_selected_gate="$(json_string "$envelope" '.selected_gate // .selected_gate_id' "")"
  last_selected_command="$(json_string "$envelope" '.selected_gate_command' "")"
  last_classification="$(json_string "$envelope" '.selected_gate_result_classification' "")"
  last_required_next_action="$(json_string "$envelope" '.required_next_action' "")"
  last_runtime_patch_allowed="$(json_bool "$envelope" '.runtime_patch_allowed')"
  last_harness_patch_allowed="$(json_bool "$envelope" '.harness_patch_allowed')"
  last_continue_refresh_allowed="$(json_bool "$envelope" '.continue_refresh_allowed')"
  last_must_stop="$(json_bool "$envelope" '.must_stop')"
  last_owning_layer="$(json_string "$envelope" '.owning_layer' "")"
  last_reason="$(json_string "$envelope" '.result_classification_reason' "")"
}

tracked_source_changed() {
  if test "$STOP_ON_TRACKED_CHANGES" != "1"; then
    return 1
  fi
  current_tracked_status="$(cd "$root" && git status --porcelain --untracked-files=no)"
  test "$current_tracked_status" != "$initial_tracked_status"
}

print_iteration_summary() {
  would_execute="$1"
  if test "$STREAM_OUTPUT" != "1"; then
    printf 'agent_goal_progress iteration=%s command_count=%s would_execute=%s\n' \
      "$iteration_count" "$command_count" "$would_execute"
    return
  fi
  printf '%s\n' "agent_goal_iteration:"
  printf 'iteration=%s\n' "$iteration_count"
  printf 'selected_gate=%s\n' "$last_selected_gate"
  printf 'selected_command=%s\n' "$last_selected_command"
  printf 'classification=%s\n' "$last_classification"
  printf 'runtime_patch_allowed=%s\n' "$last_runtime_patch_allowed"
  printf 'harness_patch_allowed=%s\n' "$last_harness_patch_allowed"
  printf 'continue_refresh_allowed=%s\n' "$last_continue_refresh_allowed"
  printf 'must_stop=%s\n' "$last_must_stop"
  printf 'required_next_action=%s\n' "$last_required_next_action"
  printf 'owning_layer=%s\n' "$last_owning_layer"
  printf 'would_execute=%s\n' "$would_execute"
}

readiness_value() {
  file="$1"
  expression="$2"
  fallback="$3"
  if test -f "$file"; then
    json_string "$file" "$expression" "$fallback"
  else
    printf '%s\n' "$fallback"
  fi
}

print_handoff() {
  stop_reason="$1"
  next_selected_gate="$(readiness_value "$envelope" '.selected_gate // .selected_gate_id' "")"
  next_selected_command="$(readiness_value "$envelope" '.selected_gate_command' "")"
  full_tcti_completion="$(readiness_value "$status_json" '.full_tcti_completion // .full_tcti_complete' "false")"
  global_runtime_readiness="$(readiness_value "$status_json" '.global_runtime_readiness // .runtime_ready // .runtime_readiness' "false")"
  package_readiness="$(readiness_value "$status_json" '.package_readiness // .package_ready' "false")"
  release_gate_eligible="$(readiness_value "$status_json" '.release_gate_eligible' "false")"
  physical_device_allowed="$(readiness_value "$status_json" '.physical_device_allowed' "false")"
  simulator_gates_complete="$(readiness_value "$status_json" '.simulator_gates_complete' "false")"
  app_visible_marker="$(readiness_value "$status_json" '.app_visible_ORLIX_USERLAND_TCTI_OK // .app_visible_orlix_userland_tcti_ok' "false")"

  printf '%s\n' "agent_goal_handoff:"
  printf 'stop_reason=%s\n' "$stop_reason"
  printf 'current_head=%s\n' "$current_head"
  printf 'iteration_count=%s\n' "$iteration_count"
  printf 'command_count=%s\n' "$command_count"
  printf 'last_selected_gate=%s\n' "$last_selected_gate"
  printf 'last_selected_command=%s\n' "$last_selected_command"
  printf 'last_classification=%s\n' "$last_classification"
  printf 'last_required_next_action=%s\n' "$last_required_next_action"
  printf 'runtime_patch_allowed=%s\n' "$last_runtime_patch_allowed"
  printf 'harness_patch_allowed=%s\n' "$last_harness_patch_allowed"
  printf 'continue_refresh_allowed=%s\n' "$last_continue_refresh_allowed"
  printf 'must_stop=%s\n' "$last_must_stop"
  printf 'owning_layer=%s\n' "$last_owning_layer"
  printf 'result_classification_reason=%s\n' "$last_reason"
  printf 'last_command_log=%s\n' "$last_command_log"
  printf 'next_selected_gate=%s\n' "$next_selected_gate"
  printf 'next_selected_command=%s\n' "$next_selected_command"
  printf '%s\n' "readiness_truth:"
  printf 'full_tcti_completion=%s\n' "$full_tcti_completion"
  printf 'global_runtime_readiness=%s\n' "$global_runtime_readiness"
  printf 'package_readiness=%s\n' "$package_readiness"
  printf 'release_gate_eligible=%s\n' "$release_gate_eligible"
  printf 'physical_device_allowed=%s\n' "$physical_device_allowed"
  printf 'simulator_gates_complete=%s\n' "$simulator_gates_complete"
  printf 'app-visible_ORLIX-USERLAND-TCTI-OK=%s\n' "$app_visible_marker"
}

refresh_after_selected_command_failure() {
  refresh_result=0
  if ! refresh_envelope; then
    refresh_result=1
  fi

  if load_envelope_fields; then
    if test "$refresh_result" = "0"; then
      print_handoff "selected command failed after classifier refresh"
    else
      print_handoff "selected command failed and classifier refresh failed"
    fi
  else
    if test "$refresh_result" = "0"; then
      print_handoff "selected command failed after classifier refresh but envelope reload failed"
    else
      print_handoff "selected command failed and classifier refresh failed"
    fi
  fi
}

run_selected_command() {
  if test "$STREAM_OUTPUT" = "1"; then
    (cd "$root" && sh -c "$last_selected_command")
    return
  fi

  last_command_log="$goal_log_dir/command-$(printf '%03d' "$command_count").log"
  (cd "$root" && sh -c "$last_selected_command") >"$last_command_log" 2>&1
}

if test "${1:-}" = "output-contract-check"; then
  iteration_count=1
  command_count=1
  last_selected_gate="output-contract-fixture"
  last_selected_command="printf 'goal-stdout-marker\\n'; printf 'goal-stderr-marker\\n' >&2"
  last_classification="stale_proof_refresh"
  last_continue_refresh_allowed="true"

  STREAM_OUTPUT=0
  quiet_output="$(print_iteration_summary true; run_selected_command)"
  quiet_command_log="$goal_log_dir/command-001.log"
  test "$quiet_output" = "agent_goal_progress iteration=1 command_count=1 would_execute=true" ||
    { printf '%s\n' "FAIL: quiet output contract leaked iteration or command details" >&2; exit 1; }
  grep -q '^goal-stdout-marker$' "$quiet_command_log" &&
    grep -q '^goal-stderr-marker$' "$quiet_command_log" ||
    { printf '%s\n' "FAIL: quiet output contract did not capture stdout and stderr" >&2; exit 1; }

  STREAM_OUTPUT=1
  streamed_output="$(print_iteration_summary true; run_selected_command 2>&1)"
  printf '%s\n' "$streamed_output" | grep -q '^agent_goal_iteration:$' &&
    printf '%s\n' "$streamed_output" | grep -q '^selected_gate=output-contract-fixture$' &&
    printf '%s\n' "$streamed_output" | grep -q '^selected_command=printf ' &&
    printf '%s\n' "$streamed_output" | grep -q '^classification=stale_proof_refresh$' &&
    printf '%s\n' "$streamed_output" | grep -q '^runtime_patch_allowed=false$' &&
    printf '%s\n' "$streamed_output" | grep -q '^harness_patch_allowed=false$' &&
    printf '%s\n' "$streamed_output" | grep -q '^continue_refresh_allowed=true$' &&
    printf '%s\n' "$streamed_output" | grep -q '^must_stop=false$' &&
    printf '%s\n' "$streamed_output" | grep -q '^goal-stdout-marker$' &&
    printf '%s\n' "$streamed_output" | grep -q '^goal-stderr-marker$' ||
    { printf '%s\n' "FAIL: streamed output contract omitted diagnostic details" >&2; exit 1; }

  printf '%s\n' "pass: output-contract-check"
  exit 0
fi

while :; do
  if test "$iteration_count" -ge "$MAX_ITERATIONS"; then
    print_handoff "MAX_ITERATIONS reached"
    exit 0
  fi

  iteration_count=$((iteration_count + 1))

  if ! refresh_envelope; then
    print_handoff "envelope refresh failed"
    exit 1
  fi

  if ! load_envelope_fields; then
    print_handoff "missing envelope fields"
    exit 1
  fi

  goal_complete="$(json_bool "$envelope" '.goal_complete')"
  can_continue="false"
  if test "$last_continue_refresh_allowed" = "true" &&
     test "$last_must_stop" = "false" &&
     test "$last_runtime_patch_allowed" = "false" &&
     test "$last_harness_patch_allowed" = "false"; then
    can_continue="true"
  fi

  print_iteration_summary "$can_continue"

  if test "$goal_complete" = "true"; then
    print_handoff "goal_complete=true"
    exit 0
  fi

  case "$last_classification" in
    *forbidden*|*environment*)
      print_handoff "$last_classification"
      exit 0
      ;;
  esac

  if test "$last_must_stop" = "true"; then
    print_handoff "must_stop=true"
    exit 0
  fi

  if test "$last_runtime_patch_allowed" = "true"; then
    print_handoff "runtime_patch_allowed=true"
    exit 0
  fi

  if test "$last_harness_patch_allowed" = "true"; then
    print_handoff "harness_patch_allowed=true"
    exit 0
  fi

  if test "$can_continue" != "true"; then
    print_handoff "policy disallows refresh continuation"
    exit 0
  fi

  if test -z "$last_selected_command"; then
    print_handoff "selected command missing"
    exit 1
  fi

  if test "$command_count" -ge "$MAX_COMMANDS"; then
    print_handoff "MAX_COMMANDS reached"
    exit 0
  fi

  if test "$DRY_RUN" = "1"; then
    continue
  fi

  command_count=$((command_count + 1))
  if ! run_selected_command; then
    refresh_after_selected_command_failure
    exit 1
  fi

  if tracked_source_changed; then
    print_handoff "tracked source changes appear"
    exit 0
  fi
done
