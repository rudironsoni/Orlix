#!/usr/bin/env sh
set -eu
target="${1:?target required}"
case "$target" in
  tcti-plan-consistency|tcti-report-schema-check|tcti-toolchain-check|tcti-contract|tcti-golden-elf|tcti-diff-switch|tcti-memory-fuzz|tcti-direct-chain-fuzz|tcti-appstore-safety-audit) ;;
  *) printf '%s\n' "unsupported report target: $target" >&2; exit 2 ;;
esac
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
report="$root/Build/TCTI/reports/$target/report.json"
test -f "$report" || { printf '%s\n' "missing report: ${report#$root/}" >&2; exit 1; }
jq . "$report"
