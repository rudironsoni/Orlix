try-import %workspace%/.bazelrc.local

common --announce_rc
common --show_timestamps
common --repository_cache=~/Library/Caches/Orlix/Bazel/repository-cache

build --show_result=20
build --verbose_failures
build --action_env=CCACHE_DIR
build --action_env=CCACHE_DISABLE
build --action_env=ORLIX_COMPILER_LAUNCHER
build --action_env=ORLIX_PACKAGE_INCREMENTAL
build --action_env=ORLIX_MLIBC_INCREMENTAL
build --action_env=ORLIX_KERNEL_INCREMENTAL
build --experimental_disk_cache_gc_max_size=30G
build --experimental_disk_cache_gc_max_age=30d

build:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_cache_compression
build:buildbuddy --experimental_remote_cache_chunking
build:buildbuddy --remote_instance_name=orlix/apple/bazel-9.2.0/xcode-17F113/v1
build:buildbuddy --remote_download_outputs=minimal
build:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:buildbuddy-read --config=buildbuddy
build:buildbuddy-read --remote_upload_local_results=false
build:buildbuddy-write --config=buildbuddy

test --test_output=errors
test --flaky_test_attempts=1

build:development --//bazel/config:profile=development
build:release --//bazel/config:profile=release

build:source --//bazel/config:component_mode=source
build:promoted --//bazel/config:component_mode=promoted

build:ci --remote_download_outputs=toplevel

build:promotion --//bazel/config:component_mode=source
build:promotion --remote_upload_local_results=false
build:promotion --action_env=ORLIX_PACKAGE_INCREMENTAL=0
build:promotion --action_env=ORLIX_MLIBC_INCREMENTAL=0
build:promotion --action_env=ORLIX_KERNEL_INCREMENTAL=0
build:promotion --action_env=ORLIX_COMPILER_LAUNCHER=
build:promotion --action_env=CCACHE_DISABLE=1

build:rules_xcodeproj --xcode_version=26.6
build:rules_xcodeproj --//bazel/config:profile=release
build:rules_xcodeproj --//bazel/config:component_mode=source
build:rules_xcodeproj --action_env=ORLIX_PINNED_DEVELOPER_DIR=/Applications/Xcode-26.6.0.app/Contents/Developer
build:rules_xcodeproj --host_action_env=ORLIX_PINNED_DEVELOPER_DIR=/Applications/Xcode-26.6.0.app/Contents/Developer
build:rules_xcodeproj --repo_env=DEVELOPER_DIR=/Applications/Xcode-26.6.0.app/Contents/Developer
build:rules_xcodeproj_generator --action_env=ORLIX_PINNED_DEVELOPER_DIR=/Applications/Xcode-26.6.0.app/Contents/Developer
build:rules_xcodeproj_generator --host_action_env=ORLIX_PINNED_DEVELOPER_DIR=/Applications/Xcode-26.6.0.app/Contents/Developer
build:rules_xcodeproj_indexbuild --xcode_version=26.6
build:rules_xcodeproj_indexbuild --action_env=ORLIX_PINNED_DEVELOPER_DIR=/Applications/Xcode-26.6.0.app/Contents/Developer
build:rules_xcodeproj_indexbuild --host_action_env=ORLIX_PINNED_DEVELOPER_DIR=/Applications/Xcode-26.6.0.app/Contents/Developer
build:rules_xcodeproj_swiftuipreviews --xcode_version=26.6
build:rules_xcodeproj_swiftuipreviews --action_env=ORLIX_PINNED_DEVELOPER_DIR=/Applications/Xcode-26.6.0.app/Contents/Developer
build:rules_xcodeproj_swiftuipreviews --host_action_env=ORLIX_PINNED_DEVELOPER_DIR=/Applications/Xcode-26.6.0.app/Contents/Developer
