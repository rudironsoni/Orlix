{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m Tools.AgentHarness.hooks.pre_tool_use",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m Tools.AgentHarness.hooks.permission_request",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m Tools.AgentHarness.hooks.post_tool_use",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m Tools.AgentHarness.hooks.subagent_start",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m Tools.AgentHarness.hooks.subagent_stop",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m Tools.AgentHarness.hooks.pre_compact",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m Tools.AgentHarness.hooks.stop",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git restore *)",
      "Bash(rm -rf *)",
      "Edit(.agents/**)",
      "Edit(.claude/**)",
      "Edit(.codex/**)",
      "Edit(.cursor/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(secrets.env)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets.env)"
    ]
  }
}
