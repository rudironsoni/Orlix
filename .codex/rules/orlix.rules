# Project-local Codex command rules for Orlix.

prefix_rule(
  pattern = ["git", "push"],
  decision = "allow",
  justification = "The project requires pushing coherent verified checkpoints.",
  match = [
    "git push",
    "git push origin main",
  ],
  not_match = [
    "git status",
  ],
)

prefix_rule(
  pattern = ["rm", "-rf"],
  decision = "forbidden",
  justification = "Do not use broad destructive deletion. Use targeted deletes after explicit scope review.",
  match = [
    "rm -rf Build",
    "rm -rf .",
  ],
  not_match = [
    "rm file.txt",
  ],
)

prefix_rule(
  pattern = ["xcrun", "simctl"],
  decision = "allow",
  justification = "Simulator inspection and control are required to verify app-hosted runtime.",
  match = [
    "xcrun simctl list",
    "xcrun simctl bootstatus ADE0D3EB-6E89-41DD-9AB9-CA20F10609F3 -b",
  ],
  not_match = [
    "xcrun devicectl list devices",
  ],
)

prefix_rule(
  pattern = ["xcrun", "devicectl"],
  decision = "forbidden",
  justification = "Direct physical-device control is not part of the simulator-first TCTI workflow.",
  match = [
    "xcrun devicectl list devices",
  ],
  not_match = [
    "xcrun simctl list devices",
  ],
)

prefix_rule(
  pattern = ["xcrun", "xctrace"],
  decision = "forbidden",
  justification = "Direct physical-device tracing is not part of the simulator-first TCTI workflow.",
  match = [
    "xcrun xctrace list devices",
  ],
  not_match = [
    "xcrun simctl list devices",
  ],
)

prefix_rule(
  pattern = ["ios-deploy"],
  decision = "forbidden",
  justification = "Direct physical-device deployment is not part of the simulator-first TCTI workflow.",
  match = [
    "ios-deploy --bundle Orlix.app",
  ],
  not_match = [
    "xcrun simctl install booted Orlix.app",
  ],
)

prefix_rule(
  pattern = ["xcodebuild", "-destination", "generic/platform=iOS"],
  decision = "forbidden",
  justification = "Direct physical-device xcodebuild is not part of the simulator-first TCTI workflow.",
  match = [
    "xcodebuild -destination generic/platform=iOS test",
  ],
  not_match = [
    "xcodebuild -destination platform=iOS Simulator,id=ADE0D3EB-6E89-41DD-9AB9-CA20F10609F3 test",
  ],
)

prefix_rule(
  pattern = ["xcodebuild", "-destination", "platform=iOS,id=00008130-001E74A11193803A"],
  decision = "forbidden",
  justification = "Direct physical-device xcodebuild is not part of the simulator-first TCTI workflow.",
  match = [
    "xcodebuild -destination platform=iOS,id=00008130-001E74A11193803A test",
  ],
  not_match = [
    "xcodebuild -destination platform=iOS Simulator,id=ADE0D3EB-6E89-41DD-9AB9-CA20F10609F3 test",
  ],
)

prefix_rule(
  pattern = ["xcodebuild"],
  decision = "allow",
  justification = "Xcode build, package resolution, simulator test, archive, and export commands are required project workflows. Device-oriented TCTI is separately blocked by hooks and runtime preflight.",
  match = [
    "xcodebuild -version",
    "xcodebuild -project Orlix.xcodeproj -scheme Orlix -destination platform=iOS Simulator,id=ADE0D3EB-6E89-41DD-9AB9-CA20F10609F3 test",
  ],
  not_match = [
    "git status",
  ],
)
