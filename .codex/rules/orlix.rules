# Project-local Codex command rules for OrlixSystem.
#
# `rtk` is an output-shrinking wrapper. Rules must cover both `cmd ...` and
# `rtk cmd ...` forms because the underlying side effect is identical.

prefix_rule(
  pattern = ["git", "push"],
  decision = "allow",
  justification = "The project requires pushing coherent verified checkpoints.",
  match = [
    "git push",
    "git push origin main",
    "git push --force-with-lease",
  ],
  not_match = [
    "git status",
  ],
)

prefix_rule(
  pattern = ["rtk", "git", "push"],
  decision = "allow",
  justification = "The project requires pushing coherent verified checkpoints.",
  match = [
    "rtk git push",
    "rtk git push origin main",
    "rtk git push --force-with-lease",
  ],
  not_match = [
    "rtk git status",
  ],
)

prefix_rule(
  pattern = ["rm", "-rf"],
  decision = "forbidden",
  justification = "Do not use broad destructive deletion. Use targeted apply_patch deletes or ask for explicit approval.",
  match = [
    "rm -rf Build",
    "rm -rf .",
  ],
  not_match = [
    "rm file.txt",
  ],
)

prefix_rule(
  pattern = ["rtk", "rm", "-rf"],
  decision = "forbidden",
  justification = "Do not use broad destructive deletion. Use targeted apply_patch deletes or ask for explicit approval.",
  match = [
    "rtk rm -rf Build",
    "rtk rm -rf .",
  ],
  not_match = [
    "rtk rm file.txt",
  ],
)

prefix_rule(
  pattern = ["timeout", "18000", "make"],
  decision = "allow",
  justification = "Long Orlix build and proof commands are expected project workflows.",
  match = [
    "timeout 18000 make -f OrlixOS/Makefile test PROFILE=release",
    "timeout 18000 make beta-archive ORLIX_DEVELOPMENT_TEAM=ZQ3L7M567L",
  ],
  not_match = [
    "timeout 1200 make test",
  ],
)

prefix_rule(
  pattern = ["rtk", "timeout", "18000", "make"],
  decision = "allow",
  justification = "Long Orlix build and proof commands are expected project workflows.",
  match = [
    "rtk timeout 18000 make -f OrlixOS/Makefile test PROFILE=release",
    "rtk timeout 18000 make beta-archive ORLIX_DEVELOPMENT_TEAM=ZQ3L7M567L",
  ],
  not_match = [
    "rtk timeout 1200 make test",
  ],
)

prefix_rule(
  pattern = ["xcrun", "simctl"],
  decision = "allow",
  justification = "Simulator inspection and control are required to verify the app-hosted runtime.",
	match = [
		"xcrun simctl list",
		"xcrun simctl bootstatus C47ED88D-0D0A-420D-8C78-D4C1D34A276D -b",
	],
  not_match = [
    "xcodebuild -version",
  ],
)

prefix_rule(
  pattern = ["rtk", "xcrun", "simctl"],
  decision = "allow",
  justification = "Simulator inspection and control are required to verify the app-hosted runtime.",
	match = [
		"rtk xcrun simctl list",
		"rtk xcrun simctl bootstatus C47ED88D-0D0A-420D-8C78-D4C1D34A276D -b",
	],
  not_match = [
    "rtk xcodebuild -version",
  ],
)

prefix_rule(
  pattern = ["xcodebuild"],
  decision = "allow",
  justification = "Xcode build, package resolution, test, archive, and export commands are required project workflows.",
  match = [
    "xcodebuild -version",
    "xcodebuild -resolvePackageDependencies -project Orlix.xcodeproj -scheme Orlix -skipPackageUpdates",
    "xcodebuild -project Orlix.xcodeproj -scheme Orlix archive",
    "xcodebuild -project Orlix.xcodeproj -scheme Orlix -destination platform=iOS Simulator,id=E65F0D05-980C-4368-8CDC-2D2BF3E05757 test",
  ],
  not_match = [
    "git status",
  ],
)

prefix_rule(
  pattern = ["rtk", "xcodebuild"],
  decision = "allow",
  justification = "Xcode build, package resolution, test, archive, and export commands are required project workflows.",
  match = [
    "rtk xcodebuild -version",
    "rtk xcodebuild -resolvePackageDependencies -project Orlix.xcodeproj -scheme Orlix -skipPackageUpdates",
    "rtk xcodebuild -project Orlix.xcodeproj -scheme Orlix archive",
    "rtk xcodebuild -project Orlix.xcodeproj -scheme Orlix -destination platform=iOS Simulator,id=E65F0D05-980C-4368-8CDC-2D2BF3E05757 test",
  ],
  not_match = [
    "rtk git status",
  ],
)
