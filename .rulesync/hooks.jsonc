{
  "version": 1,
  "hooks": {
    "preToolUse": [{ "type": "command", "command": "python3 -m Tools.AgentHarness.hooks.pre_tool_use", "timeout": 30 }],
    "permissionRequest": [{ "type": "command", "command": "python3 -m Tools.AgentHarness.hooks.permission_request", "timeout": 30 }],
    "postToolUse": [{ "type": "command", "command": "python3 -m Tools.AgentHarness.hooks.post_tool_use", "timeout": 30 }],
    "subagentStart": [{ "type": "command", "command": "python3 -m Tools.AgentHarness.hooks.subagent_start", "timeout": 30 }],
    "subagentStop": [{ "type": "command", "command": "python3 -m Tools.AgentHarness.hooks.subagent_stop", "timeout": 30 }],
    "preCompact": [{ "type": "command", "command": "python3 -m Tools.AgentHarness.hooks.pre_compact", "timeout": 30 }],
    "stop": [{ "type": "command", "command": "python3 -m Tools.AgentHarness.hooks.stop", "timeout": 30 }]
  }
}
