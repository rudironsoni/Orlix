#!/usr/bin/env sh
set -eu

mode="${1:-}"
root="$(cd "$(dirname "$0")/../../../.." && pwd)"
output_dir="${ORLIX_BUILD_ROOT:-$root/Build}/AgentHarness/orlix-tcti"
status_path="$output_dir/status.json"
envelope_path="$output_dir/next-task.json"

mkdir -p "$output_dir"

python3 - "$mode" "$root" "$status_path" "$envelope_path" <<'PY'
import json
import pathlib
import subprocess
import sys

mode, root_text, status_text, envelope_text = sys.argv[1:]
root = pathlib.Path(root_text)
status_path = pathlib.Path(status_text)
envelope_path = pathlib.Path(envelope_text)
head = subprocess.check_output(
    ["git", "rev-parse", "HEAD"], cwd=root, text=True
).strip()

suites = [
    {
        "id": "complete-target-isa-audit",
        "owner": "OrlixKernel C-native ISA audit",
        "command": "make tcti-isa-audit",
        "required_conditions": "requires a complete target inventory, exact feature-domain evaluation, classification, and proof-registry integrity; the envelope records no audit result",
    },
    {
        "id": "kernel-dependency-kunit",
        "owner": "OrlixKernel",
        "command": "make tcti-kernel-tests",
        "required_conditions": "requires app-hosted kernel dependency proof and production-path TCTI KUnit; the envelope records no test result",
    },
    {
        "id": "kernel-kselftest",
        "owner": "upstream Linux",
        "command": "make tcti-kernel-tests",
        "required_conditions": "requires Linux kernel-interface kselftest after KUnit; the envelope records no test result",
    },
    {
        "id": "mlibc",
        "owner": "OrlixMLibC and upstream mlibc",
        "command": "make mlibc-tests PROFILE=development",
        "required_conditions": "requires libc proof through the upstream mlibc suite after kernel-interface proof; the envelope records no test result",
    },
    {
        "id": "mlibc-syscall-uapi",
        "owner": "OrlixMLibC and upstream Linux",
        "command": "owning OrlixMLibC-built kselftest command",
        "required_conditions": "requires OrlixMLibC-built syscall and UAPI proof after upstream mlibc proof; the envelope records no test result",
    },
    {
        "id": "posix-shell",
        "owner": "OrlixOS package integration",
        "command": "owning POSIX shell proof command",
        "required_conditions": "requires normal Linux POSIX shell environment proof after OrlixMLibC syscall and UAPI proof; the envelope records no test result",
    },
    {
        "id": "coreutils",
        "owner": "OrlixOS package integration and upstream Coreutils",
        "command": "make coreutils-tests PROFILE=development",
        "required_conditions": "requires Coreutils compatibility proof without replacing the package ladder; the envelope records no test result",
    },
    {
        "id": "jq",
        "owner": "OrlixOS package integration",
        "command": "owning jq package proof command",
        "required_conditions": "requires jq package proof after the POSIX shell tier; the envelope records no test result",
    },
    {
        "id": "curl",
        "owner": "OrlixOS package integration",
        "command": "owning curl package proof command",
        "required_conditions": "requires curl package proof after jq; the envelope records no test result",
    },
    {
        "id": "zsh",
        "owner": "OrlixOS package integration",
        "command": "owning zsh package proof command",
        "required_conditions": "requires zsh package proof after curl; the envelope records no test result",
    },
    {
        "id": "hostadapter",
        "owner": "OrlixHostAdapter",
        "command": "make hostadapter-tests",
        "required_conditions": "requires private Darwin memory and source-preserving terminal transport proof; the envelope records no test result",
    },
    {
        "id": "orlixos",
        "owner": "OrlixOS",
        "command": "make orlixos-tests",
        "required_conditions": "requires payload, session, and app-facing OS Kit proof; the envelope records no test result",
    },
    {
        "id": "app",
        "owner": "native Orlix app",
        "command": "make app-tests",
        "required_conditions": "requires application integration and presentation proof; the envelope records no test result",
    },
    {
        "id": "app-hosted-runtime",
        "owner": "native app plus OrlixOS session",
        "command": "make runtime-tests PROFILE=development",
        "required_conditions": "requires the complete app-hosted promotion suite to be rerun after per-family ISA coverage closes; the envelope records no test result",
    },
]

status = {
    "schema_version": 1,
    "area": "orlix-tcti",
    "git_sha": head,
    "product_profiles": ["release", "development"],
    "test_suites": suites,
    "completion": "unverified",
    "completion_reason": "This is a scope contract. Owning suites provide current results in their native formats.",
}

envelope = {
    "schema_version": 1,
    "area": "orlix-tcti",
    "git_sha": head,
    "selected_task": "complete-aarch64-isa-on-isa-coverage",
    "task_page": "docs/objects/task/doing/complete-aarch64-isa-on-isa-coverage.md",
    "selected_test_suite": suites[0],
    "ordered_test_suites": suites,
    "scope_contract": {
        "allowed_owners": [
            "OrlixKernel C-native ISA audit",
            "OrlixKernel KUnit and Linux kselftest",
            "OrlixMLibC tests",
            "upstream Coreutils tests",
            "OrlixOS package integration",
            "OrlixHostAdapter XCTest",
            "OrlixOS XCTest",
            "native app XCTest",
        ],
        "forbidden_substitutes": [
            "host-side TCTI behavioral models",
            "terminal text or log parsing as TCTI proof",
            "generated-tree edits",
            "a TCTI-specific product profile",
        ],
    },
    "completion": "unverified",
}

if mode == "status":
    status_path.write_text(json.dumps(status, indent=2) + "\n")
    print(json.dumps(status, indent=2))
elif mode == "next":
    status_path.write_text(json.dumps(status, indent=2) + "\n")
    envelope_path.write_text(json.dumps(envelope, indent=2) + "\n")
    print(json.dumps(envelope, indent=2))
elif mode == "check":
    if not envelope_path.is_file():
        raise SystemExit(f"missing task envelope: {envelope_path}")
    observed = json.loads(envelope_path.read_text())
    if observed != envelope:
        raise SystemExit("task envelope is stale; run make agent-next AREA=orlix-tcti")
    encoded = json.dumps(observed)
    forbidden = [
        "tcti_" + "runtime",
        "tcti-" + "gate",
        "golden_" + "elf",
        "tcti-" + "repro",
    ]
    matches = [value for value in forbidden if value in encoded]
    if matches:
        raise SystemExit(f"task envelope contains retired contracts: {matches}")
    print("Orlix TCTI task envelope valid")
else:
    raise SystemExit("usage: scope-envelope status|next|check")
PY
