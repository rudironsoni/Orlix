{
  "servers": {
    "openaiDeveloperDocs": {
      "url": "https://developers.openai.com/mcp",
      "required": false,
      "tool_timeout_sec": 60
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "disabled": true,
      "required": false,
      "tool_timeout_sec": 60,
      "env_http_headers": {
        "CONTEXT7_API_KEY": "CONTEXT7_API_KEY"
      }
    },
    "lldb": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec \"$(xcrun --find lldb-mcp)\""
      ],
      "required": false,
      "tool_timeout_sec": 60
    }
  }
}
