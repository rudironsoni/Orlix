{
    "triggerTaskOnSave.tasks": {
        "sweetpad: build": [
            "**/*.swift"
        ]
    },
    "triggerTaskOnSave.on": true,
    "triggerTaskOnSave.showNotifications": false,
    "triggerTaskOnSave.restart": true,
    "triggerTaskOnSave.delay": 1000,
    "triggerTaskOnSave.resultIndicatorResetTimeout": 5,
    "workbench.colorCustomizations": {},
    "sweetpad.format.args": [
        "--in-place",
        "--configuration",
        ".vscode/.swift-format",
        "${file}"
    ],
    "[swift]": {
        "editor.defaultFormatter": "sweetpad.sweetpad",
        "editor.formatOnSave": true
    },
    "sweetpad.build.xcodeWorkspacePath": "Orlix.xcodeproj/project.xcworkspace",
    "sweetpad.buildServer.provider": "xcode-build-server",
    "chat.tools.terminal.autoApprove": {
        "rm -rf *": false,
        "git clean *": false,
        "git reset --hard *": false,
        "git restore *": false
    },
    "chat.tools.edits.autoApprove": {
        ".env": false,
        ".env.*": false,
        "secrets.env": false,
        ".agents/**": false,
        ".claude/**": false,
        ".codex/**": false,
        ".cursor/**": false
    }
}
