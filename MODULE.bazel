module(
    name = "orlix",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "apple_support", version = "2.2.0", repo_name = "build_bazel_apple_support")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_swift", version = "3.6.1")
bazel_dep(name = "rules_apple", version = "4.5.3")
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")
bazel_dep(name = "rules_swift_package_manager", version = "1.21.0")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//third_party/swift:Package.resolved",
    swift = "//third_party/swift:Package.swift",
)
swift_deps.configure_package(
    build_file = "//third_party/swift:mlx.BUILD.bazel",
    name = "mlx-swift",
)
use_repo(swift_deps, "swift_package", "swiftpkg_mlx_swift", "swiftpkg_opentelemetry_swift", "swiftpkg_opentelemetry_swift_core", "swiftpkg_swift_cloudflared", "swiftpkg_swift_et", "swiftpkg_swift_mosh", "swiftpkg_swift_numerics", "swiftpkg_tweetnacl_swiftwrap", "swiftpkg_zipfoundation")
