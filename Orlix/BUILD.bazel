load("@rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@rules_apple//apple:ios.bzl", "ios_application", "ios_extension", "ios_framework", "ios_ui_test", "ios_unit_test")
load("@rules_apple//apple:resources.bzl", "apple_resource_group")
load("@rules_apple//apple:xcarchive.bzl", "xcarchive")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

local_provisioning_profile(
    name = "OrlixDevelopmentProfile",
    profile_name = "iOS Team Provisioning Profile: com.rudironsoni.Orlix",
    tags = ["manual"],
    team_id = "ZQ3L7M567L",
)

local_provisioning_profile(
    name = "OrlixLiveActivityDevelopmentProfile",
    profile_name = "iOS Team Provisioning Profile: *",
    tags = ["manual"],
    team_id = "ZQ3L7M567L",
)

cc_library(
    name = "ghostty_headers",
    tags = ["manual"],
    deps = select({
        "//bazel/feasibility/native:ios_device": ["@orlix_ghostty_kit//:capi_ios_device"],
        "//conditions:default": ["@orlix_ghostty_kit//:capi_ios_simulator"],
    }),
)

cc_library(
    name = "ssh2_headers",
    hdrs = glob(["Vendor/libssh2/include/*.h"]),
    includes = ["Vendor/libssh2/include"],
    tags = ["manual"],
)

objc_library(
    name = "GhosttyAbortShim",
    srcs = ["Orlix/Core/Terminal/Ghostty/Bridge/GhosttyLibCppVerboseAbortShim+iOS.mm"],
    alwayslink = True,
    copts = [
        "-fno-objc-arc",
        "-std=c++20",
    ],
    tags = ["manual"],
)

_TEST_SWIFT_FEATURES = [
    flag
    for feature in [
        "DisableOutwardActorInference",
        "GlobalActorIsolatedTypesUsability",
        "InferIsolatedConformances",
        "InferSendableFromCaptures",
        "NonisolatedNonsendingByDefault",
        "MemberImportVisibility",
    ]
    for flag in ["-enable-upcoming-feature", feature]
]

[
    swift_library(
        name = name,
        testonly = is_test_host,
        srcs = glob([
            "Orlix/App/**/*.swift",
            "Orlix/Core/**/*.swift",
            "Orlix/Features/**/*.swift",
            "OrlixShared/*.swift",
        ], exclude = ["Orlix/App/Orlix.swift"]) + [entrypoint],
        copts = [
            "-swift-version",
            "5" if is_test_host else "6",
            "-default-isolation=MainActor",
            "-strict-concurrency=minimal",
            "-DORLIX_BETA_OBSERVABILITY",
            "-import-objc-header",
            "Orlix/Orlix/ghostty-bridging-header.h",
        ] + (_TEST_SWIFT_FEATURES + ["-enable-testing"] if is_test_host else []),
        features = ["swift.add_target_name_to_output"] if is_test_host else [],
        swiftc_inputs = ["Orlix/ghostty-bridging-header.h"],
        defines = [
            "ORLIX_APP_HOSTED_BOOT=1",
            "ORLIX_BETA_OBSERVABILITY=1",
            "ORLIX_GHOSTTY_SPM=1",
        ],
        module_name = "Orlix",
        tags = ["manual"],
        deps = [
            ":GhosttyAbortShim",
            ":ghostty_headers",
            ":ssh2_headers",
            "//OrlixOS/Sources/Session:OrlixOS",
            "@swiftpkg_mlx_swift//:MLX",
            "@swiftpkg_mlx_swift//:MLXFFT",
            "@swiftpkg_mlx_swift//:MLXNN",
            "@swiftpkg_opentelemetry_swift//:OpenTelemetryProtocolExporterHTTP",
            "@swiftpkg_opentelemetry_swift_core//:OpenTelemetryApi",
            "@swiftpkg_opentelemetry_swift_core//:OpenTelemetrySdk",
            "@swiftpkg_swift_cloudflared//:Cloudflared",
            "@swiftpkg_swift_et//:ETBootstrap",
            "@swiftpkg_swift_et//:ETSession",
            "@swiftpkg_swift_mosh//:MoshBootstrap",
            "@swiftpkg_swift_mosh//:MoshCore",
            "@swiftpkg_zipfoundation//:ZIPFoundation",
        ],
    )
    for name, entrypoint, is_test_host in [
        ("OrlixAppLibrary", "Orlix/App/Orlix.swift", False),
        ("OrlixTestAppLibrary", "//OrlixTestApp:Sources/OrlixTestApp.swift", True),
    ]
]

swift_library(
    name = "OrlixLiveActivityLibrary",
    srcs = glob([
        "OrlixLiveActivity/**/*.swift",
        "OrlixShared/*.swift",
    ]),
    copts = [
        "-swift-version",
        "5",
    ],
    module_name = "OrlixLiveActivity",
    tags = ["manual"],
)

ios_extension(
    name = "OrlixLiveActivity",
    bundle_id = "com.rudironsoni.Orlix.live-activity",
    entitlements = select({
        "//bazel/feasibility/native:ios_device": "OrlixLiveActivity/Bazel.entitlements",
        "//conditions:default": None,
    }),
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["OrlixLiveActivity/BazelInfo.plist"],
    minimum_os_version = "16.1",
    provisioning_profile = select({
        "//bazel/feasibility/native:ios_device": ":OrlixLiveActivityDevelopmentProfile",
        "//conditions:default": None,
    }),
    resources = glob(["OrlixLiveActivity/Assets.xcassets/**"]) + glob(["OrlixLiveActivity/Resources/**"]),
    tags = ["manual"],
    deps = [":OrlixLiveActivityLibrary"],
)

apple_resource_group(
    name = "os_resources",
    structured_resources = [
        "//bazel/feasibility/rootfs:payload",
        "//bazel/feasibility/kernel:macho_boot_resources",
    ],
    strip_structured_resources_prefixes = ["payload", "macho"],
    tags = ["manual"],
)

ios_framework(
    name = "OrlixOSFramework",
    bundle_id = "com.rudironsoni.orlix.os",
    bundle_name = "OrlixOS",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["//OrlixOS/Sources/Session:info_plist"],
    minimum_os_version = "15.0",
    resources = [
        ":os_resources",
        "//bazel/product:kernel_composition",
    ] + select({
        "//bazel/config:component_promoted": ["//bazel/promotion:promoted_apple_inputs"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
    deps = [
        "//OrlixCoreUtils/Sources/Provider:OrlixCoreUtilsProvider",
        "//OrlixHostAdapter/Sources:OrlixHostAdapter",
        "//OrlixKernel/Sources:OrlixKernelBoot",
        "//OrlixMLibC/Sources/Provider:OrlixMLibCProvider",
        "//OrlixOS/Sources/Session:OrlixOS",
        "//bazel/feasibility/kernel:macho_link",
    ],
)

ios_application(
    name = "Orlix",
    bundle_id = "com.rudironsoni.Orlix",
    entitlements = "Orlix-iOS/Bazel.entitlements",
    extensions = [":OrlixLiveActivity"],
    frameworks = [":OrlixOSFramework"],
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Orlix-iOS/BazelInfo.plist"],
    minimum_os_version = "15.0",
    provisioning_profile = select({
        "//bazel/feasibility/native:ios_device": ":OrlixDevelopmentProfile",
        "//conditions:default": None,
    }),
    resources = [
        "//Orlix/Orlix/Resources:folder_resources",
        "//Orlix/Orlix/Resources:bundle_resources",
        "Orlix/PrivacyInfo.xcprivacy",
        "//docs/sources/release:orlix-app-release-inputs.json",
    ] + glob(["Orlix/Assets.xcassets/**"]) + select({
        "//bazel/config:component_promoted": ["//bazel/promotion:locked_buildset"],
        "//conditions:default": [],
    }),
    linkopts = [
        "-weak_framework",
        "AppIntents",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":OrlixAppLibrary",
        "//OrlixCoreUtils/Sources/Provider:OrlixCoreUtilsProvider",
        "//OrlixHostAdapter/Sources:OrlixHostAdapter",
        "//OrlixKernel/Sources:OrlixKernelBoot",
        "//OrlixMLibC/Sources/Provider:OrlixMLibCProvider",
        "//bazel/feasibility/kernel:macho_link",
        "//bazel/feasibility/native:native_link_smoke",
    ],
)

xcarchive(
    name = "Orlix.xcarchive",
    bundle = ":Orlix",
    tags = ["manual"],
)

swift_library(
    name = "OrlixUITestsLibrary",
    testonly = True,
    srcs = glob(["OrlixUITests/**/*.swift"]),
    copts = [
        "-swift-version",
        "5",
    ],
    module_name = "OrlixUITests",
    tags = ["manual"],
)

ios_ui_test(
    name = "OrlixUITests",
    minimum_os_version = "15.0",
    tags = ["manual"],
    test_host = ":Orlix",
    visibility = ["//visibility:public"],
    deps = [":OrlixUITestsLibrary"],
)

ios_application(
    name = "OrlixTestApp",
    testonly = True,
    bundle_id = "com.rudironsoni.orlix.test-app",
    entitlements = "Orlix-iOS/Bazel.entitlements",
    families = ["iphone", "ipad"],
    frameworks = [":OrlixOSFramework"],
    infoplists = ["Orlix-iOS/BazelInfo.plist"],
    minimum_os_version = "15.0",
    resources = [
        "//Orlix/Orlix/Resources:folder_resources",
        "//Orlix/Orlix/Resources:bundle_resources",
        "Orlix/PrivacyInfo.xcprivacy",
        "OrlixStoreKit.storekit",
        "//docs/sources/release:orlix-app-release-inputs.json",
    ] + glob(["Orlix/Assets.xcassets/**"]),
    linkopts = ["-weak_framework", "AppIntents"],
    tags = ["manual"],
    deps = [
        ":OrlixTestAppLibrary",
        "//OrlixCoreUtils/Sources/Provider:OrlixCoreUtilsProvider",
        "//OrlixHostAdapter/Sources:OrlixHostAdapter",
        "//OrlixKernel/Sources:OrlixKernelBoot",
        "//OrlixMLibC/Sources/Provider:OrlixMLibCProvider",
        "//bazel/feasibility/kernel:macho_link",
        "//bazel/feasibility/native:native_link_smoke",
    ],
)

swift_library(
    name = "OrlixTestsLibrary",
    testonly = True,
    srcs = glob(["OrlixTests/**/*.swift"]),
    copts = ["-swift-version", "5"] + _TEST_SWIFT_FEATURES,
    module_name = "OrlixTests",
    tags = ["manual"],
    deps = [
        ":OrlixTestAppLibrary",
        "@swiftpkg_swift_cloudflared//:Cloudflared",
        "@swiftpkg_swift_et//:ETBootstrap",
        "@swiftpkg_swift_et//:ETSession",
        "@swiftpkg_swift_mosh//:MoshBootstrap",
        "@swiftpkg_swift_mosh//:MoshCore",
        "@swiftpkg_zipfoundation//:ZIPFoundation",
    ],
)

ios_unit_test(
    name = "OrlixTests",
    bundle_id = "com.rudironsoni.orlix.tests",
    minimum_os_version = "15.0",
    resources = ["OrlixTests/Core/SSH/RemoteSessions/Fixtures/zellij-fixture.sh"],
    tags = ["manual"],
    test_host = ":OrlixTestApp",
    deps = [":OrlixTestsLibrary"],
)
