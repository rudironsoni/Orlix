<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Orlix</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>42</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.rudironsoni.orlix.cloudflare</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>orlix-cfaccess</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Orlix needs microphone access to transcribe voice commands to terminal input.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Orlix uses speech recognition to convert voice to terminal commands.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Orlix uses Face ID to unlock the app and protected servers.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Orlix uses your local network to find, wake, and connect to SSH servers.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
