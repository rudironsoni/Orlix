<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Push Notifications -->
    <key>aps-environment</key>
    <string>$(APS_ENVIRONMENT)</string>

    <!-- iCloud/CloudKit -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.rudironsoni.orlix</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.rudironsoni.orlix</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.rudironsoni.orlix</string>
	</array>

    <!-- Fonts installed by the user or another app -->
    <key>com.apple.developer.user-fonts</key>
    <array>
        <string>app-usage</string>
    </array>

    <!-- Network -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Keychain sharing -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.rudironsoni.orlix</string>
    </array>
</dict>
</plist>
