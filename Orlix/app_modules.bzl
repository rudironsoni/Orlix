    "OrlixSettings": [],
    "OrlixTerminal": [":GhosttyAbortShim", "//OrlixOS/Sources/Session:OrlixOS", "@swiftpkg_mlx_swift//:MLX", "@swiftpkg_mlx_swift//:MLXFFT", "@swiftpkg_mlx_swift//:MLXNN", "@swiftpkg_swift_et//:ETBootstrap", "@swiftpkg_swift_et//:ETSession", "@swiftpkg_swift_mosh//:MoshBootstrap", "@swiftpkg_swift_mosh//:MoshCore", "@swiftpkg_zipfoundation//:ZIPFoundation"],
    "OrlixComposition": [],
    "OrlixApp": [],
}

_COPTS = [
    "-swift-version",
    "6",
    "-default-isolation=MainActor",
    "-strict-concurrency=minimal",
    "-DORLIX_BETA_OBSERVABILITY",
    "-DORLIX_MODULAR_APP",
]

_DEFINES = [
    "ORLIX_APP_HOSTED_BOOT=1",
    "ORLIX_BETA_OBSERVABILITY=1",
    "ORLIX_GHOSTTY_SPM=1",
]

def orlix_app_modules():
    for name, srcs in ORLIX_APP_MODULE_SRCS.items():
        bridging = name in _BRIDGING
        header_deps = [":ghostty_headers", ":ssh2_headers"] if bridging else []
        swift_library(
            name = name,
            srcs = srcs,
            copts = _COPTS + ([
                "-import-objc-header",
                "Orlix/Orlix/ghostty-bridging-header.h",
            ] if bridging else []),
            defines = _DEFINES,
            module_name = name,
            package_name = "Orlix",
            swiftc_inputs = ["Orlix/ghostty-bridging-header.h"] if bridging else [],
            tags = ["manual"],
            deps = header_deps + ORLIX_APP_MODULE_DEPS[name] + _EXTRA_DEPS[name],
        )

