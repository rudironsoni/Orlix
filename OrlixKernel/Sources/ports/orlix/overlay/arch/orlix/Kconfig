config ORLIX
	bool "Orlix architecture"
	default y
	select GENERIC_IRQ_SHOW
	select IRQ_DOMAIN
	select HAVE_PAGE_SIZE_4KB
	select HAVE_PAGE_SIZE_16KB
	select OF
	select OF_IRQ
	select HAS_IOMEM
	select GENERIC_VDSO_TIME_NS
	select HAS_DMA
	select ARCH_WANT_FRAME_POINTERS
	select GENERIC_CPU_DEVICES
	select LOCK_MM_AND_FIND_VMA
	select CLONE_BACKWARDS
	select THREAD_INFO_IN_TASK

config 64BIT
	bool
	default y

config MMU
	bool
	default y

config PGTABLE_LEVELS
	int
	default 4

config GENERIC_CSUM
	def_bool y

config GENERIC_CALIBRATE_DELAY
	def_bool y

config GENERIC_HWEIGHT
	def_bool y

config ORLIX_HOSTED_ASYNC_USER_TIMER
	bool
	default y

config ORLIX_HOSTED_EXEC_NATIVE
	bool "Use native hosted user execution"
	default y
	help
	  Keep the existing HostAdapter trap-frame native execution backend
	  available as an explicit development backend.

config ORLIX_HOSTED_EXEC_TCTI
	bool "Use Orlix TCTI hosted user execution"
	default n
	help
	  Enable the Orlix-owned no-JIT same-ISA threaded interpreter backend
	  for AArch64 Linux ELF userspace. This backend executes guest text as
	  host data and must not request host-executable mappings for guest ELF
	  text.

config ORLIX_TCTI_DEBUG_SWITCH
	bool "Enable Orlix TCTI switch debug oracle"
	depends on ORLIX_HOSTED_EXEC_TCTI
	default y if DEBUG_KERNEL
	help
	  Build the slow switch-dispatch correctness oracle used to test TCTI
	  decoding, fault, syscall, and register semantics. It is not the
	  physical-iPhone performance backend.

config ORLIX_TCTI_SYSCALL_TRACE
	bool "Trace every Orlix TCTI syscall entry and return"
	depends on ORLIX_HOSTED_EXEC_TCTI
	default n
	help
	  Enable full per-syscall TCTI tracing. The default TCTI runtime keeps
	  syscall-entry reporting bounded so app-hosted Linux workloads are not
	  throttled by console mirroring.

config ORLIX_TCTI_KUNIT_TEST
	bool "Enable Orlix TCTI KUnit tests"
	depends on ORLIX_HOSTED_EXEC_TCTI && KUNIT
	default n

source "kernel/Kconfig.hz"
