/*
 * Canonical typed ordinal-to-proof projection.
 *
 * The source-bound proof ledger is the sole row authority. Consumers define
 * ORLIX_TCTI_A64_PROOF_REGISTRY_BINDING, then include this adapter to project
 * every source-bound row without copying the ledger or scraping source text.
 * An enclosing source-bound macro is restored after the projection include.
 */
#ifndef ORLIX_TCTI_A64_PROOF_REGISTRY_BINDING
#error "define ORLIX_TCTI_A64_PROOF_REGISTRY_BINDING before including this projection"
#endif

#ifndef ORLIX_TCTI_A64_PROOF_REGISTRY_PROJECTION_SOURCE
#define ORLIX_TCTI_A64_PROOF_REGISTRY_PROJECTION_SOURCE "source_bound_proof.def"
#define ORLIX_TCTI_A64_PROOF_REGISTRY_PROJECTION_SOURCE_DEFAULT 1
#endif

#ifdef ORLIX_TCTI_A64_SOURCE_BOUND_PROOF
#pragma push_macro("ORLIX_TCTI_A64_SOURCE_BOUND_PROOF")
#undef ORLIX_TCTI_A64_SOURCE_BOUND_PROOF
#define ORLIX_TCTI_A64_PROOF_REGISTRY_PROJECTION_RESTORE_SOURCE_BOUND 1
#endif

#define ORLIX_TCTI_A64_SOURCE_BOUND_PROOF(ordinal, proof_id) \
	ORLIX_TCTI_A64_PROOF_REGISTRY_BINDING(ordinal, proof_id)
#include ORLIX_TCTI_A64_PROOF_REGISTRY_PROJECTION_SOURCE
#undef ORLIX_TCTI_A64_SOURCE_BOUND_PROOF

#ifdef ORLIX_TCTI_A64_PROOF_REGISTRY_PROJECTION_RESTORE_SOURCE_BOUND
#pragma pop_macro("ORLIX_TCTI_A64_SOURCE_BOUND_PROOF")
#undef ORLIX_TCTI_A64_PROOF_REGISTRY_PROJECTION_RESTORE_SOURCE_BOUND
#endif

#ifdef ORLIX_TCTI_A64_PROOF_REGISTRY_PROJECTION_SOURCE_DEFAULT
#undef ORLIX_TCTI_A64_PROOF_REGISTRY_PROJECTION_SOURCE_DEFAULT
#undef ORLIX_TCTI_A64_PROOF_REGISTRY_PROJECTION_SOURCE
#endif
