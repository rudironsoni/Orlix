/*
 * Linux auxiliary-vector capability to OrlixTCTI proof ownership.
 *
 * ORLIX_EL0_HWCAP and ORLIX_EL0_HWCAP2 in asm/isa.h remain authoritative for
 * what Linux advertises. These rows map an advertised bit to its Arm feature,
 * but capability promotion is decided only by the complete source-leaf ledger.
 * They do not select, exclude, or count Arm source leaves in the complete
 * target inventory.
 */

ORLIX_TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_FP, FEAT_FP, FP)
ORLIX_TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_ASIMD, FEAT_AdvSIMD, ASIMD)
ORLIX_TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_AES, FEAT_AES, AES)
ORLIX_TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_PMULL, FEAT_AES, PMULL)
ORLIX_TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SHA1, FEAT_SHA1, SHA)
ORLIX_TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SHA2, FEAT_SHA256, SHA)
ORLIX_TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_CRC32, FEAT_CRC32, CRC32)
ORLIX_TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SHA3, FEAT_SHA3, SHA3)
ORLIX_TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SHA512, FEAT_SHA512, SHA512)
ORLIX_TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SM3, FEAT_SM3, SM3)
ORLIX_TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SM4, FEAT_SM4, SM4)

/*
 * Active execution is a separate, image-owned TCTI policy.  These rows are
 * deliberately independent of Linux auxiliary-vector advertisement above.
 * A feature becomes ENABLED only with a matching reviewed promotion manifest.
 */
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME2, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME_B16B16, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME_F16F16, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME_F64F64, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME_F8F16, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME_F8F32, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME_FA64, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME_I16I64, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME_LUTv2, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME_MOP4, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SME_TMOP, DISABLED, "tcti-141-sme-floating-point")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SVE, DISABLED, "tcti-147-sve-crypto")
ORLIX_TCTI_A64_ACTIVE_EXECUTION_FEATURE(FEAT_SVE2, DISABLED, "tcti-147-sve-crypto")
