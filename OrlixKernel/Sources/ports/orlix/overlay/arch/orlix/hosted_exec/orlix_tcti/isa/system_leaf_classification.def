/*
 * Reviewed system-instruction leaf contract for the pinned Arm AARCHMRS
 * 2026-06 source, ordinals 2281 through 2287.
 *
 * A generic system instruction encodes an accessor selector.  Its source leaf
 * cannot be collapsed into one EL disposition where the authoritative register
 * source carries feature-conditioned accessors.  The variant-required rows are
 * explicit completion blockers until the system-accessor dispatcher has an
 * authoritative EL0 partition and its owning KUnit proof.
 *
 * Arguments: ordinal, leaf, operation, feature predicate, EL classification,
 * relation, ASL operation, owning implementation, proof id, implementation
 * status, proof status.
 */
ORLIX_TCTI_SYSTEM_LEAF_CLASSIFICATION(2281U, "SYS_CR_systeminstrs", "SYS", "true",
	ORLIX_TCTI_SYSTEM_LEAF_EL0_VARIANT_REQUIRED,
	ORLIX_TCTI_SYSTEM_LEAF_RELATION_NONE, "operations/SYS",
	"arch/orlix:orlix-tcti-system-accessor-dispatch",
	"kunit:system-leaf-accessor-partition", ORLIX_TCTI_SYSTEM_LEAF_PENDING,
	ORLIX_TCTI_SYSTEM_LEAF_UNPROVED)
ORLIX_TCTI_SYSTEM_LEAF_CLASSIFICATION(2282U, "SYSL_RC_systeminstrs", "SYSL", "true",
	ORLIX_TCTI_SYSTEM_LEAF_EL0_VARIANT_REQUIRED,
	ORLIX_TCTI_SYSTEM_LEAF_RELATION_NONE, "operations/SYSL",
	"arch/orlix:orlix-tcti-system-accessor-dispatch",
	"kunit:system-leaf-accessor-partition", ORLIX_TCTI_SYSTEM_LEAF_PENDING,
	ORLIX_TCTI_SYSTEM_LEAF_UNPROVED)
ORLIX_TCTI_SYSTEM_LEAF_CLASSIFICATION(2283U, "MSR_SR_systemmove", "MSR_reg", "true",
	ORLIX_TCTI_SYSTEM_LEAF_EL0_VARIANT_REQUIRED,
	ORLIX_TCTI_SYSTEM_LEAF_RELATION_NONE, "operations/MSR_reg",
	"arch/orlix:orlix-tcti-system-accessor-dispatch",
	"kunit:system-leaf-accessor-partition", ORLIX_TCTI_SYSTEM_LEAF_PENDING,
	ORLIX_TCTI_SYSTEM_LEAF_UNPROVED)
ORLIX_TCTI_SYSTEM_LEAF_CLASSIFICATION(2284U, "MRS_RS_systemmove", "MRS", "true",
	ORLIX_TCTI_SYSTEM_LEAF_EL0_VARIANT_REQUIRED,
	ORLIX_TCTI_SYSTEM_LEAF_RELATION_NONE, "operations/MRS",
	"arch/orlix:orlix-tcti-system-accessor-dispatch",
	"kunit:system-leaf-accessor-partition", ORLIX_TCTI_SYSTEM_LEAF_PENDING,
	ORLIX_TCTI_SYSTEM_LEAF_UNPROVED)
ORLIX_TCTI_SYSTEM_LEAF_CLASSIFICATION(2285U, "SYSP_CR_syspairinstrs", "SYSP",
	"FEAT_SYSINSTR128",
	ORLIX_TCTI_SYSTEM_LEAF_FEATURE_CONDITIONED_EL0_PARTITION_REQUIRED,
	ORLIX_TCTI_SYSTEM_LEAF_RELATION_NONE, "operations/SYSP",
	"arch/orlix:orlix-tcti-system-accessor-dispatch",
	"kunit:system-leaf-accessor-partition", ORLIX_TCTI_SYSTEM_LEAF_PENDING,
	ORLIX_TCTI_SYSTEM_LEAF_UNPROVED)
ORLIX_TCTI_SYSTEM_LEAF_CLASSIFICATION(2286U, "MSRR_SR_systemmovepr", "MSRR",
	"FEAT_SYSREG128",
	ORLIX_TCTI_SYSTEM_LEAF_FEATURE_CONDITIONED_EL0_PARTITION_REQUIRED,
	ORLIX_TCTI_SYSTEM_LEAF_RELATION_NONE, "operations/MSRR",
	"arch/orlix:orlix-tcti-system-accessor-dispatch",
	"kunit:system-leaf-accessor-partition", ORLIX_TCTI_SYSTEM_LEAF_PENDING,
