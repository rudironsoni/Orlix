/* Generic registry input. Family workers add one ORLIX_TCTI_PRODUCTION_CAPTURE
 * row per executable source/obligation. Do not invent a second observation
 * schema. #120 is the shared contract those rows bind. Later families add
 * another include; METADATA is an array so a second family does not redefine
 * a singleton. #134 binds through the ordinary-load-store registry and the
 * capture rows in orlix_tcti_base_load_store_production_capture.def.
 * #126 binds through the AdvSIMD load/store registry and the capture rows
 * in orlix_tcti_advsimd_load_store_production_capture.def.
 */
#include "orlix_tcti_branch_control_production_capture.def"
#include "orlix_tcti_base_load_store_production_capture.def"
#include "orlix_tcti_advsimd_load_store_production_capture.def"
#include "orlix_tcti_base_atomic_production_capture.def"
#include "orlix_tcti_base_add_sub_production_capture.def"
#include "orlix_tcti_base_control_flow_production_capture.def"
#include "orlix_tcti_base_exceptions_production_capture.def"
#include "orlix_tcti_base_conditional_production_capture.def"
#include "orlix_tcti_base_bitfield_unary_production_capture.def"
#include "orlix_tcti_base_multiply_divide_production_capture.def"
#include "orlix_tcti_advsimd_crypto_production_capture.def"
#include "orlix_tcti_advsimd_permute_move_production_capture.def"
#include "orlix_tcti_advsimd_integer_production_capture.def"
#include "orlix_tcti_advsimd_fp_production_capture.def"
