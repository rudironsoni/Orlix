/*
 * Linux auxiliary-vector capability to TCTI proof ownership.
 *
 * ORLIX_EL0_HWCAP and ORLIX_EL0_HWCAP2 in asm/isa.h remain authoritative for
 * what Linux advertises. These rows map an advertised bit to its Arm feature,
 * but capability promotion is decided only by the complete source-leaf ledger.
 * They do not select, exclude, or count Arm source leaves in the complete
 * target inventory.
 */

TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_FP, FEAT_FP, FP)
TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_ASIMD, FEAT_AdvSIMD, ASIMD)
TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_AES, FEAT_AES, AES)
TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_PMULL, FEAT_AES, PMULL)
TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SHA1, FEAT_SHA1, SHA)
TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SHA2, FEAT_SHA256, SHA)
TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_CRC32, FEAT_CRC32, CRC32)
TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SHA3, FEAT_SHA3, SHA3)
TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SHA512, FEAT_SHA512, SHA512)
TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SM3, FEAT_SM3, SM3)
TCTI_A64_RUNTIME_CAPABILITY(AUXV_HWCAP, HWCAP_SM4, FEAT_SM4, SM4)
