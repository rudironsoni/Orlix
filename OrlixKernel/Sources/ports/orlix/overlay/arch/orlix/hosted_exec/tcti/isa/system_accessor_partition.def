/*
 * Explicit EL0 partition for concrete system-register accessors currently
 * accepted by the production decoder. Register source identities are TREG_REG
 * identifiers from target_register_artifact.def, generated from the pinned
 * Arm AARCHMRS 2026-06 register source.
 *
 * The partition remains incomplete. A selector absent from this table is an
 * unresolved completion blocker. It cannot become an implicit EL0 acceptance.
 * Generic system-move leaves retain their AARCHMRS source ordinals here, while
 * SYS, SYSP, MSRR, and MRRS feature-conditioned variants remain explicitly
 * pending in system_leaf_classification.def.
 *
 * Arguments: source leaf ordinal, instruction source name, generic operation,
 * direction, selector, register source identity, register name, feature
 * predicate, disposition.
 */
TCTI_SYSTEM_ACCESSOR_PARTITION(2284U, "A64.MRS", "MRS", \
	TCTI_SYSTEM_ACCESSOR_READ, 0xde82U, 1033U, "TPIDR_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2283U, "A64.MSRregister", "MSR_reg", \
	TCTI_SYSTEM_ACCESSOR_WRITE, 0xde82U, 1033U, "TPIDR_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2284U, "A64.MRS", "MRS", \
	TCTI_SYSTEM_ACCESSOR_READ, 0xda10U, 711U, "NZCV", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2283U, "A64.MSRregister", "MSR_reg", \
	TCTI_SYSTEM_ACCESSOR_WRITE, 0xda10U, 711U, "NZCV", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2284U, "A64.MRS", "MRS", \
	TCTI_SYSTEM_ACCESSOR_READ, 0xda20U, 467U, "FPCR", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2283U, "A64.MSRregister", "MSR_reg", \
	TCTI_SYSTEM_ACCESSOR_WRITE, 0xda20U, 467U, "FPCR", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2284U, "A64.MRS", "MRS", \
	TCTI_SYSTEM_ACCESSOR_READ, 0xda21U, 470U, "FPSR", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2283U, "A64.MSRregister", "MSR_reg", \
	TCTI_SYSTEM_ACCESSOR_WRITE, 0xda21U, 470U, "FPSR", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2284U, "A64.MRS", "MRS", \
	TCTI_SYSTEM_ACCESSOR_READ, 0xde83U, 1037U, "TPIDRRO_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2284U, "A64.MRS", "MRS", \
	TCTI_SYSTEM_ACCESSOR_READ, 0xd801U, 405U, "CTR_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2284U, "A64.MRS", "MRS", \
	TCTI_SYSTEM_ACCESSOR_READ, 0xd807U, 440U, "DCZID_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2284U, "A64.MRS", "MRS", \
	TCTI_SYSTEM_ACCESSOR_READ, 0xdf00U, 365U, "CNTFRQ_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)
TCTI_SYSTEM_ACCESSOR_PARTITION(2284U, "A64.MRS", "MRS", \
	TCTI_SYSTEM_ACCESSOR_READ, 0xdf02U, 389U, "CNTVCT_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_EL0_IMPLEMENTED)

/* Writes to the read-only accessors are rejected at EL0 by current TCTI. */
TCTI_SYSTEM_ACCESSOR_PARTITION(2283U, "A64.MSRregister", "MSR_reg", \
	TCTI_SYSTEM_ACCESSOR_WRITE, 0xde83U, 1037U, "TPIDRRO_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_PRIVILEGED_REJECTION)
TCTI_SYSTEM_ACCESSOR_PARTITION(2283U, "A64.MSRregister", "MSR_reg", \
	TCTI_SYSTEM_ACCESSOR_WRITE, 0xd801U, 405U, "CTR_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_PRIVILEGED_REJECTION)
TCTI_SYSTEM_ACCESSOR_PARTITION(2283U, "A64.MSRregister", "MSR_reg", \
	TCTI_SYSTEM_ACCESSOR_WRITE, 0xd807U, 440U, "DCZID_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_PRIVILEGED_REJECTION)
TCTI_SYSTEM_ACCESSOR_PARTITION(2283U, "A64.MSRregister", "MSR_reg", \
	TCTI_SYSTEM_ACCESSOR_WRITE, 0xdf00U, 365U, "CNTFRQ_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_PRIVILEGED_REJECTION)
TCTI_SYSTEM_ACCESSOR_PARTITION(2283U, "A64.MSRregister", "MSR_reg", \
	TCTI_SYSTEM_ACCESSOR_WRITE, 0xdf02U, 389U, "CNTVCT_EL0", "true", \
	TCTI_SYSTEM_ACCESSOR_PRIVILEGED_REJECTION)
