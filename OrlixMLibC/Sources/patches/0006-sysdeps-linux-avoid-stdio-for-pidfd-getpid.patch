+int formatPidfdFdinfoPath(int fd, char *path, size_t pathSize) {
+	const char prefix[] = "/proc/self/fdinfo/";
+	char digits[16];
+	size_t n = 0;
+	size_t pos = 0;
+	unsigned int value;
+
+	if(fd < 0)
+		return EBADF;
+
+	for(size_t i = 0; i < sizeof(prefix) - 1; i++) {
+		if(pos + 1 >= pathSize)
+			return ENAMETOOLONG;
+		path[pos++] = prefix[i];
+	}
+
+	value = static_cast<unsigned int>(fd);
+	do {
+		digits[n++] = static_cast<char>('0' + (value % 10));
+		value /= 10;
+	} while(value);
+
+	while(n) {
+		if(pos + 1 >= pathSize)
+			return ENAMETOOLONG;
+		path[pos++] = digits[--n];
+	}
+	path[pos] = 0;
+	return 0;
+}
+
+bool parsePidfdPidLine(const char *buffer, size_t size, pid_t *outpid) {
+	const char prefix[] = "Pid:";
+
+	for(size_t i = 0; i + sizeof(prefix) - 1 <= size; i++) {
+		if(i && buffer[i - 1] != '\n')
+			continue;
+		if(memcmp(buffer + i, prefix, sizeof(prefix) - 1))
+			continue;
+
+		i += sizeof(prefix) - 1;
+		while(i < size && (buffer[i] == ' ' || buffer[i] == '\t'))
+			i++;
+
+		bool negative = false;
+		if(i < size && buffer[i] == '-') {
+			negative = true;
+			i++;
+		}
+
+		long pid = 0;
+		bool sawDigit = false;
+		while(i < size && buffer[i] >= '0' && buffer[i] <= '9') {
+			sawDigit = true;
+			pid = pid * 10 + (buffer[i] - '0');
+			i++;
+		}
+		if(!sawDigit)
+			return false;
+
+		*outpid = negative ? -pid : pid;
+		return true;
+	}
+
+	return false;
+}
 
