diff --git a/options/internal/generic/charcode.cpp b/options/internal/generic/charcode.cpp
--- a/options/internal/generic/charcode.cpp
+++ b/options/internal/generic/charcode.cpp
@@ -2,6 +2,7 @@
 #include <bits/ensure.h>
 #include <frg/string.hpp>
 #include <mlibc/charcode.hpp>
+#include <mlibc/locale.hpp>
 #include <mlibc/debug.hpp>
 
 namespace mlibc {
@@ -142,4 +143,48 @@ struct utf8_charcode {
 	};
 };
 
+struct ascii_charcode {
+	static constexpr bool preserves_7bit_units = true;
+	static constexpr bool has_shift_states = false;
+
+	struct decode_state {
+		decode_state()
+		: _progress{0}, _cpoint{0} { }
+
+		decode_state(int progress, codepoint cpoint)
+		: _progress{progress}, _cpoint{cpoint} { }
+
+		auto progress() { return _progress; }
+		auto cpoint() { return _cpoint; }
+
+		transcode_status operator() (code_seq<const char> &seq) {
+			auto uc = static_cast<unsigned char>(*seq.it);
+			if (uc > 0x7f)
+				return transcode_status::illegal_input;
+			_cpoint = uc;
+			_progress = 0;
+			++seq.it;
+			return transcode_status::input_exhausted;
+		}
+
+	private:
+		int _progress;
+		codepoint _cpoint;
+	};
+
+	struct encode_state {
+		transcode_status operator()(code_seq<char> &nseq, code_seq<const codepoint> &wseq) {
+			auto cp = *wseq.it;
+			if (cp > 0x7f)
+				return transcode_status::illegal_input;
+			if (!nseq)
+				return transcode_status::output_overflow;
+			*nseq.it = static_cast<char>(cp);
+			++nseq.it;
+			++wseq.it;
+			return transcode_status::input_exhausted;
+		}
+	};
+};
+
 polymorphic_charcode::~polymorphic_charcode() = default;
@@ -316,4 +361,8 @@ polymorphic_charcode *current_charcode() {
 	static polymorphic_charcode_adapter<utf8_charcode> global_charcode;
-	return &global_charcode;
+	static polymorphic_charcode_adapter<ascii_charcode> global_ascii_charcode;
+	if (localeWasSelected()
+			&& getActiveLocale()->ctype.get(_NL_CTYPE_MB_CUR_MAX).asUint32() == 1)
+		return &global_ascii_charcode;
+	return &global_charcode;
 }
 
