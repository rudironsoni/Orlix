)

config_setting(
    name = "origin_mlibc_source",
    flag_values = {":origin_mlibc": "source"},
)

config_setting(
    name = "origin_mlibc_promoted",
    flag_values = {":origin_mlibc": "promoted"},
)

config_setting(
    name = "origin_rootfs_source",
    flag_values = {":origin_rootfs": "source"},
)

config_setting(
    name = "origin_rootfs_promoted",
    flag_values = {":origin_rootfs": "promoted"},
)

config_setting(
    name = "promoted_lock_enabled",
    flag_values = {":use_promoted_lock": "true"},
)
