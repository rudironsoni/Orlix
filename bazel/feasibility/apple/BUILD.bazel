load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:private"])

swift_library(
    name = "SmokeAppLibrary",
    srcs = ["SmokeApp.swift"],
    module_name = "OrlixBazelFeasibility",
    tags = ["manual"],
)

ios_application(
    name = "SmokeApp",
    bundle_id = "com.rudironsoni.orlix.bazel-feasibility",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "15.0",
    tags = ["manual"],
    deps = [":SmokeAppLibrary"],
)
