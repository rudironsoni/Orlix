load(":kernel_uapi.bzl", "orlix_kernel_uapi", "orlix_kernel_uapi_variant")
load(":kernel_macho.bzl", "orlix_kernel_macho_archive", "orlix_kernel_macho_library", "orlix_tcti_isa_prepare")
load("//bazel/selection:boundary.bzl", "orlix_selected_linux_archive", "orlix_selected_uapi")

package(default_visibility = ["//visibility:private"])

exports_files(["kbuild_persist.py"])

orlix_kernel_uapi(
    name = "uapi",
    linux_makefile = "@orlix_linux_source//:Makefile",
    linux_source = "@orlix_linux_source//:source",
    tags = ["manual"],
    visibility = [
        "//bazel/feasibility:__subpackages__",
        "//bazel/product:__pkg__",
    ],
)

orlix_selected_uapi(
    name = "selected_uapi",
    origin = select({
        "//bazel/config:origin_uapi_promoted": "//bazel/promotion:promoted_uapi",
        "//conditions:default": ":uapi",
    }),
    visibility = [
        "//Orlix:__pkg__",
        "//bazel/feasibility:__subpackages__",
        "//bazel/product:__pkg__",
        "//bazel/promotion:__pkg__",
    ],
)

[
    orlix_kernel_uapi_variant(
        name = "uapi_%s_%s" % (destination, profile),
        destination = destination,
        profile = profile,
        tags = ["manual"],
        uapi = ":uapi",
        visibility = ["//bazel/feasibility:__subpackages__"],
    )
    for destination in [
        "iphoneos",
        "iphonesimulator",
    ]
    for profile in [
        "development",
        "release",
    ]
]

orlix_tcti_isa_prepare(
    name = "tcti_isa",
    archive = "//OrlixKernel/Sources:tcti_isa_archive",
    members_def = "//OrlixKernel/Sources:tcti_isa_members_def",
    members_make = "//OrlixKernel/Sources:tcti_isa_members_make",
    pin = "//OrlixKernel/Sources:tcti_isa_archive_sha256",
    serializer = ":kbuild_persist.py",
    tags = ["manual"],
    visibility = ["//bazel/feasibility:__subpackages__"],
)

orlix_kernel_macho_archive(
    name = "macho",
    toolchain_identity = "@orlix_kernel_toolchain//:identity.json",
    compiler_identity = "@orlix_kernel_toolchain//:compiler-identity.json",
    profile = select({
        "//bazel/config:profile_development": "development",
        "//conditions:default": "release",
    }),
    destination = select({
        "//bazel/feasibility/native:ios_device": "iphoneos",
        "//conditions:default": "iphonesimulator",
    }),
    configs = "//OrlixKernel/Sources:linux_configs",
    extra_inputs = [
        "//:make/tcti-proof-registry-provenance.mk",
        "//:OrlixOS/Sources/distribution/target-settings.xcconfig",
    ],
    kbuild_engine = "//OrlixKernel/Sources:kbuild_engine",
    isa_tree = ":tcti_isa",
    linux_makefile = "@orlix_linux_source//:Makefile",
    linux_source = "@orlix_linux_source//:source",
    overlay = "//OrlixKernel/Sources:linux_overlay",
    patches = "//OrlixKernel/Sources:linux_patches",
    tags = ["manual"],
    visibility = [
        "//Orlix:__pkg__",
        "//bazel/feasibility:__subpackages__",
        "//bazel/product:__pkg__",
    ],
)

[
    orlix_kernel_macho_archive(
        name = "kernel-%s-%s" % (profile, destination),
        toolchain_identity = "@orlix_kernel_toolchain//:identity.json",
        compiler_identity = "@orlix_kernel_toolchain//:compiler-identity.json",
        profile = profile,
        destination = destination,
        configs = "//OrlixKernel/Sources:linux_configs",
        extra_inputs = [
            "//:make/tcti-proof-registry-provenance.mk",
            "//:OrlixOS/Sources/distribution/target-settings.xcconfig",
        ],
        kbuild_engine = "//OrlixKernel/Sources:kbuild_engine",
        isa_tree = ":tcti_isa",
        linux_makefile = "@orlix_linux_source//:Makefile",
        linux_source = "@orlix_linux_source//:source",
        overlay = "//OrlixKernel/Sources:linux_overlay",
        patches = "//OrlixKernel/Sources:linux_patches",
        tags = ["manual"],
        visibility = [
            "//Orlix:__pkg__",
            "//bazel/feasibility:__subpackages__",
            "//bazel/product:__pkg__",
            "//bazel/promotion:__pkg__",
        ],
    )
    for profile in [
        "release",
        "development",
    ]
    for destination in [
        "iphoneos",
        "iphonesimulator",
    ]
]

config_setting(
    name = "promoted_release_iphoneos",
    constraint_values = [
        "@platforms//os:ios",
        "@build_bazel_apple_support//constraints:device",
    ],
    flag_values = {
        "//bazel/config:origin_kernel": "promoted",
        "//bazel/config:profile": "release",
    },
)

config_setting(
    name = "promoted_release_iphonesimulator",
    constraint_values = [
        "@platforms//os:ios",
        "@build_bazel_apple_support//constraints:simulator",
    ],
    flag_values = {
        "//bazel/config:origin_kernel": "promoted",
        "//bazel/config:profile": "release",
    },
)

config_setting(
    name = "promoted_development_iphoneos",
    constraint_values = [
        "@platforms//os:ios",
        "@build_bazel_apple_support//constraints:device",
    ],
    flag_values = {
        "//bazel/config:origin_kernel": "promoted",
        "//bazel/config:profile": "development",
    },
)

config_setting(
    name = "promoted_development_iphonesimulator",
    constraint_values = [
        "@platforms//os:ios",
        "@build_bazel_apple_support//constraints:simulator",
    ],
    flag_values = {
        "//bazel/config:origin_kernel": "promoted",
        "//bazel/config:profile": "development",
    },
)

orlix_selected_linux_archive(
    name = "selected_macho",
    origin = select({
        ":promoted_development_iphoneos": "//bazel/promotion:promoted_kernel_development_iphoneos",
        ":promoted_development_iphonesimulator": "//bazel/promotion:promoted_kernel_development_iphonesimulator",
        ":promoted_release_iphoneos": "//bazel/promotion:promoted_kernel_release_iphoneos",
        ":promoted_release_iphonesimulator": "//bazel/promotion:promoted_kernel_release_iphonesimulator",
        "//conditions:default": ":macho",
    }),
    visibility = [
        "//Orlix:__pkg__",
        "//bazel/feasibility:__subpackages__",
        "//bazel/product:__pkg__",
        "//bazel/promotion:__pkg__",
    ],
)

filegroup(
    name = "macho_boot_resources",
    srcs = [":selected_macho"],
    output_group = "boot_resources",
    tags = ["manual"],
    visibility = ["//Orlix:__pkg__"],
)

filegroup(
    name = "macho_archive",
    srcs = [":selected_macho"],
    output_group = "archive",
    tags = ["manual"],
    visibility = [
        "//Orlix:__pkg__",
        "//bazel/feasibility:__subpackages__",
        "//bazel/product:__pkg__",
    ],
)

orlix_kernel_macho_library(
    name = "macho_link",
    archive = ":macho_archive",
    tags = ["manual"],
    visibility = [
        "//Orlix:__pkg__",
        "//bazel/feasibility:__subpackages__",
        "//bazel/product:__pkg__",
    ],
)
