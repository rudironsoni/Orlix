orlix_autotools_package(
    name = "grep",
    cache_vars = [
        "gl_cv_func_getopt_gnu=yes",
        "gl_cv_func_getopt_long_gnu=yes",
    ],
    configure = "@orlix_grep_source//:configure",
    configure_args = [
        "--host=aarch64-linux-gnu",
        "--build=aarch64-apple-darwin",
        "--prefix=/usr",
        "--disable-nls",
        "--disable-perl-regexp",
        "--disable-gcc-warnings",
    ],
    file_expect = "ELF 64-bit LSB pie executable, ARM aarch64",
    install_map = ["src/grep:usr/bin/grep"],
    link_mode = "pie",
    make_steps = [
        "-C lib -j1 all",
        "-C src -j1 grep",
    ],
    package_name = "grep",
    package_version = "3.12",
    sources = "@orlix_grep_source//:source",
    sysroot = _SYSROOT,
    tags = ["manual"],
    uapi = _UAPI,
    verify_files = ["usr/bin/grep"],
    visibility = ["//bazel/feasibility:__subpackages__"],
)

