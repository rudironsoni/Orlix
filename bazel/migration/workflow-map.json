{
  "schema": 1,
  "purpose": "Resolved workflow trigger, permission, environment, job, step, action, artifact, and release-operation inventory.",
  "workflows": {
    ".github/workflows/app-store-review.yml": {
      "source_sha256": "38afaa5c6995d1564b0c2111edbe62b9fbdfd72aa397bd30577398240b36ad07",
      "workflow": {
        "name": "Promote TestFlight beta to App Review",
        "on": {
          "workflow_dispatch": {
            "inputs": {
              "beta_tag": {
                "description": "Protected beta tag, for example ios-v0.1-b42",
                "required": true,
                "type": "string"
              }
            }
          }
        },
        "permissions": {
          "actions": "read",
          "contents": "read"
        },
        "concurrency": {
          "group": "app-store-review-${{ inputs.beta_tag }}",
          "cancel-in-progress": false
        },
        "jobs": {
          "submit-for-review": {
            "name": "Submit exact beta for App Review",
            "runs-on": "ubuntu-24.04",
            "environment": "app-store-review",
            "timeout-minutes": 30,
            "env": {
              "ORLIX_RELEASE_REPOSITORY": "${{ github.repository }}",
              "ORLIX_RELEASE_TAG": "${{ inputs.beta_tag }}",
              "ORLIX_RELEASE_REPORT_INPUT": "${{ github.workspace }}/beta-evidence/AgentHarness/orlix-release/release.json"
            },
            "steps": [
              {
                "name": "Check out the protected beta tag",
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "ref": "refs/tags/${{ inputs.beta_tag }}",
                  "fetch-depth": 0
                }
              },
              {
                "name": "Resolve the tag and successful beta run",
                "id": "beta",
                "env": {
                  "GH_TOKEN": "${{ github.token }}"
                },
                "run": "set -euo pipefail\ngit fetch --no-tags origin main:refs/remotes/origin/main\ncommit=\"$(git rev-list -n 1 \"refs/tags/$ORLIX_RELEASE_TAG\")\"\ntest -n \"$commit\"\nrun_id=\"$(gh api \"repos/$GITHUB_REPOSITORY/actions/workflows/testflight-beta.yml/runs?event=push&status=success&head_sha=$commit\" --jq '.workflow_runs[0].id // empty')\"\ntest -n \"$run_id\" || { echo \"No successful beta workflow exists for $ORLIX_RELEASE_TAG at $commit\" >&2; exit 1; }\necho \"commit=$commit\" >> \"$GITHUB_OUTPUT\"\necho \"run_id=$run_id\" >> \"$GITHUB_OUTPUT\"\necho \"ORLIX_RELEASE_COMMIT=$commit\" >> \"$GITHUB_ENV\"\necho \"ORLIX_RELEASE_RUN_ID=$run_id\" >> \"$GITHUB_ENV\"\n"
              },
              {
                "name": "Download exact beta evidence",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "orlix-testflight-${{ inputs.beta_tag }}",
                  "path": "beta-evidence",
                  "github-token": "${{ github.token }}",
                  "run-id": "${{ steps.beta.outputs.run_id }}"
                }
              },
              {
                "name": "Set up Ruby and pinned Fastlane",
                "uses": "ruby/setup-ruby@95ef2b042f9d7a56d8268cba8559e2842e2ad01b",
                "with": {
                  "ruby-version": "3.4.8",
                  "bundler-cache": true
                }
              },
              {
                "name": "Materialize App Store Connect credentials",
                "env": {
                  "APPSTORE_API_KEY_ID": "${{ vars.APPSTORE_API_KEY_ID }}",
                  "APPSTORE_ISSUER_ID": "${{ vars.APPSTORE_ISSUER_ID }}",
                  "APPSTORE_API_PRIVATE_KEY": "${{ secrets.APPSTORE_API_PRIVATE_KEY }}"
                },
                "run": "set -euo pipefail\ntest -n \"$APPSTORE_API_PRIVATE_KEY\"\numask 077\nprivate_key=\"$RUNNER_TEMP/AuthKey.p8\"\nexport ORLIX_FASTLANE_API_KEY_PATH=\"$RUNNER_TEMP/appstore-api-key.json\"\nprintf '%s' \"$APPSTORE_API_PRIVATE_KEY\" > \"$private_key\"\nexport private_key\nruby -rjson -e 'File.write(ENV.fetch(\"ORLIX_FASTLANE_API_KEY_PATH\"), JSON.pretty_generate({key_id: ENV.fetch(\"APPSTORE_API_KEY_ID\"), issuer_id: ENV.fetch(\"APPSTORE_ISSUER_ID\"), key_filepath: ENV.fetch(\"private_key\"), in_house: false}))'\necho \"ORLIX_FASTLANE_API_KEY_PATH=$ORLIX_FASTLANE_API_KEY_PATH\" >> \"$GITHUB_ENV\"\n"
              },
              {
                "name": "Validate and submit the exact beta",
                "run": "make app-store-promote"
              }
            ]
          }
        }
      }
    },
    ".github/workflows/bazel-benchmark.yml": {
      "source_sha256": "0075acdfe1def5575897c472a98b049c5407349cf93de5d8b397e64a8f50eb0d",
      "workflow": {
        "name": "Bazel component benchmark",
        "on": {
          "workflow_dispatch": null,
          "schedule": [
            {
              "cron": "39 4 * * 0"
            }
          ]
        },
        "permissions": {
          "contents": "read"
        },
        "concurrency": {
          "group": "bazel-benchmark",
          "cancel-in-progress": false
        },
        "jobs": {
          "benchmark": {
            "name": "Measure clean and cached component builds",
            "if": "github.ref == 'refs/heads/main' && github.repository == 'rudironsoni/Orlix'",
            "runs-on": "macos-26",
            "timeout-minutes": 180,
            "steps": [
              {
                "name": "Check out the exact commit",
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "persist-credentials": false
                }
              },
              {
                "name": "Select Xcode 26.6",
                "uses": "maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90",
                "with": {
                  "xcode-version": "26.6"
                }
              },
              {
                "name": "Export the selected Xcode to Make",
                "run": "set -euo pipefail\necho \"ORLIX_PINNED_DEVELOPER_DIR=$(xcode-select -p)\" >> \"$GITHUB_ENV\"\ntest \"$(xcodebuild -version | head -n 1)\" = \"Xcode 26.6\"\ntest \"$(xcodebuild -version | sed -n '2p')\" = \"Build version 17F113\"\n"
              },
              {
                "name": "Install build tools",
                "run": "brew bundle --file Brewfile"
              },
              {
                "name": "Measure and compare component builds through Make",
                "run": "set -euo pipefail\nmkdir -p Build/AgentHarness/bazel-migration\n/usr/bin/time -l make __bazel-cache-equivalence 2>&1 | tee Build/AgentHarness/bazel-migration/benchmark.log\n"
              },
              {
                "name": "Store benchmark evidence",
                "if": "always()",
                "uses": "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
                "with": {
                  "name": "bazel-benchmark-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}",
                  "path": "Build/AgentHarness/bazel-migration/benchmark.log\nBuild/Bazel/toolchain.json\nBuild/Bazel/cache-equivalence.*/comparison.json\nBuild/Bazel/cache-equivalence.*/*/build-events.json\nBuild/Bazel/cache-equivalence.*/*/profile.json.gz\nBuild/Bazel/cache-equivalence.*/*/execution.json\nBuild/Bazel/cache-equivalence.*/*/cache-observation.json\n",
                  "if-no-files-found": "error",
                  "retention-days": 14
                }
              }
            ]
          }
        }
      }
    },
    ".github/workflows/bazel-ci.yml": {
      "source_sha256": "0b8c28a4228a9c5801d54749a13fe618181f6a79693408f431247dd2d3314aaa",
      "workflow": {
        "name": "Bazel CI",
        "on": {
          "workflow_dispatch": null,
          "pull_request": null,
          "push": {
            "branches": [
              "main"
            ]
          }
        },
        "permissions": {
          "contents": "read"
        },
        "concurrency": {
          "group": "${{ github.event_name == 'pull_request' && format('bazel-ci-pr-{0}', github.event.pull_request.number) || (github.ref == 'refs/heads/main' && 'bazel-ci-main' || format('bazel-ci-manual-{0}', github.ref_name)) }}",
          "cancel-in-progress": true
        },
        "jobs": {
          "apple-ci": {
            "name": "Bazel matrix check",
            "runs-on": "macos-26",
            "timeout-minutes": 120,
            "steps": [
              {
                "name": "Check out the exact commit",
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "persist-credentials": false
                }
              },
              {
                "name": "Select Xcode 26.6",
                "uses": "maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90",
                "with": {
                  "xcode-version": "26.6"
                }
              },
              {
                "name": "Restore Bazel repository cache",
                "uses": "actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830",
                "with": {
                  "path": "~/Library/Caches/Orlix/Bazel/repository-cache",
                  "key": "orlix-bazel-repos-${{ hashFiles('MODULE.bazel.lock', 'bazel/extensions/ghostty_zig_packages.json') }}",
                  "restore-keys": "orlix-bazel-repos-\n"
                }
              },
              {
                "name": "Restore iOS 15.5 runtime archive",
                "uses": "actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830",
                "with": {
                  "path": "~/Library/Caches/Orlix/ios15-runtime",
                  "key": "orlix-ios-runtime-15.5-arm64-71fd7d0159a4439ebef1abb2b1e0b26204b74af903dcc579a7b6e131065a1150"
                }
              },
              {
                "name": "Install declared build tools",
                "run": "set -euo pipefail\nbrew trust --formula xcodesorg/made/xcodes\nbrew bundle --file Brewfile\ntest \"$(xcodes version)\" = \"2.0.3\"\n"
              },
              {
                "name": "Export the selected Xcode to Make",
                "run": "set -euo pipefail\necho \"ORLIX_PINNED_DEVELOPER_DIR=$(xcode-select -p)\" >> \"$GITHUB_ENV\"\ntest \"$(xcodebuild -version | head -n 1)\" = \"Xcode 26.6\"\ntest \"$(xcodebuild -version | sed -n '2p')\" = \"Build version 17F113\"\n"
              },
              {
                "name": "Resolve BuildBuddy cache policy",
                "id": "buildbuddy",
                "env": {
                  "ORLIX_BUILDBUDDY_CACHE_MODE": "${{ vars.ORLIX_BUILDBUDDY_CACHE_MODE || 'normal' }}",
                  "ORLIX_BUILDBUDDY_CONTEXT": "${{ github.event_name == 'push' && 'main' || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository && github.actor != 'dependabot[bot]' && 'pr' || 'fork') }}"
                },
                "run": "make __bazel-buildbuddy-policy"
              },
              {
                "name": "Configure trusted BuildBuddy writes",
                "if": "steps.buildbuddy.outputs.access == 'write'",
                "env": {
                  "BUILDBUDDY_API_KEY": "${{ secrets.BUILDBUDDY_API_KEY_WRITE }}",
                  "ORLIX_BUILDBUDDY_ACCESS": "write"
                },
                "run": "make __bazel-buildbuddy-configure"
              },
              {
                "name": "Configure read-only BuildBuddy access",
                "if": "steps.buildbuddy.outputs.access == 'read'",
                "env": {
                  "BUILDBUDDY_API_KEY": "${{ secrets.BUILDBUDDY_API_KEY_READ }}",
                  "ORLIX_BUILDBUDDY_ACCESS": "read"
                },
                "run": "make __bazel-buildbuddy-configure"
              },
              {
                "name": "Prepare both simulator runtimes",
                "run": "set -euo pipefail\nmkdir -p \"$HOME/Library/Caches/Orlix/ios15-runtime\"\nsudo xcodes runtimes install \"iOS 15.5\" --architecture arm64 --directory \"$HOME/Library/Caches/Orlix/ios15-runtime\" --keep-archive --no-color\ncurrent_runtime_id=\"$(xcrun simctl list runtimes -j | jq -r '.runtimes[] | select(.version == \"26.5\" and .isAvailable == true) | .identifier' | head -n 1)\"\nios15_runtime_id=\"$(xcrun simctl list runtimes -j | jq -r '.runtimes[] | select(.version == \"15.5\" and .isAvailable == true) | .identifier' | head -n 1)\"\ntest -n \"$current_runtime_id\"\ntest -n \"$ios15_runtime_id\"\ndevice_type=\"com.apple.CoreSimulator.SimDeviceType.iPhone-13\"\nxcrun simctl list devicetypes -j | jq -e --arg identifier \"$device_type\" '.devicetypes[] | select(.identifier == $identifier)' >/dev/null\ncurrent_id=\"$(xcrun simctl create \"Orlix current CI\" \"$device_type\" \"$current_runtime_id\")\"\nios15_id=\"$(xcrun simctl create \"Orlix iOS 15.5 CI\" \"$device_type\" \"$ios15_runtime_id\")\"\ntest -n \"$current_id\"\ntest -n \"$ios15_id\"\nxcrun simctl boot \"$current_id\"\nxcrun simctl boot \"$ios15_id\"\nxcrun simctl bootstatus \"$current_id\" -b\nxcrun simctl bootstatus \"$ios15_id\" -b\n{\n  echo \"ORLIX_CURRENT_SIMULATOR_ID=$current_id\"\n  echo \"ORLIX_CURRENT_SIMULATOR_VERSION=26.5\"\n  echo \"ORLIX_IOS15_SIMULATOR_ID=$ios15_id\"\n} >> \"$GITHUB_ENV\"\n"
              },
              {
                "name": "Run the Make-owned Apple CI operation",
                "env": {
                  "ORLIX_BAZEL_COMPONENT_MODE": "${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'source' || 'promoted' }}",
                  "ORLIX_BUILDBUDDY_ACCESS": "${{ steps.buildbuddy.outputs.access }}",
                  "ORLIX_COSIGN_PUB": "${{ vars.ORLIX_COSIGN_PUB }}",
                  "ORLIX_ORAS_REGISTRY_CONFIG": "${{ runner.temp }}/orlix-registry.json"
                },
                "run": "make __bazel-apple-ci"
              },
              {
                "name": "Save Bazel repository cache",
                "if": "github.event_name == 'push' && github.ref == 'refs/heads/main'",
                "uses": "actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830",
                "with": {
                  "path": "~/Library/Caches/Orlix/Bazel/repository-cache",
                  "key": "orlix-bazel-repos-${{ hashFiles('MODULE.bazel.lock', 'bazel/extensions/ghostty_zig_packages.json') }}"
                }
              },
              {
                "name": "Save iOS 15.5 runtime archive",
                "if": "github.event_name == 'push' && github.ref == 'refs/heads/main'",
                "uses": "actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830",
                "with": {
                  "path": "~/Library/Caches/Orlix/ios15-runtime",
                  "key": "orlix-ios-runtime-15.5-arm64-71fd7d0159a4439ebef1abb2b1e0b26204b74af903dcc579a7b6e131065a1150"
                }
              },
              {
                "name": "Remove BuildBuddy credentials",
                "if": "always()",
                "run": "make __bazel-buildbuddy-cleanup"
              },
              {
                "name": "Store Apple CI evidence",
                "if": "always()",
                "uses": "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
                "with": {
                  "name": "bazel-apple-ci-${{ github.sha }}",
                  "path": "Build/AgentHarness/bazel-ci\nBuild/**/*.xcresult\nBuild/**/*.log\n~/Library/Logs/DiagnosticReports\n",
                  "if-no-files-found": "warn",
                  "retention-days": 14
                }
              }
            ]
          }
        }
      }
    },
    ".github/workflows/bazel-gc.yml": {
      "source_sha256": "0d9d1f9a60bde2b321b55896d87118b29f7901176adb22d0a7503ff53322cb89",
      "workflow": {
        "name": "Bazel cache garbage collection",
        "on": {
          "workflow_dispatch": null,
          "schedule": [
            {
              "cron": "17 5 * * 1"
            }
          ]
        },
        "permissions": {
          "contents": "read"
        },
        "concurrency": {
          "group": "bazel-gc",
          "cancel-in-progress": true
        },
        "jobs": {
          "gc": {
            "name": "Bound local cache growth",
            "runs-on": "macos-26",
            "timeout-minutes": 30,
            "steps": [
              {
                "name": "Check out the exact commit",
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "persist-credentials": false
                }
              },
              {
                "name": "Select Xcode 26.6",
                "uses": "maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90",
                "with": {
                  "xcode-version": "26.6"
                }
              },
              {
                "name": "Install declared build tools",
                "run": "brew bundle --file Brewfile"
              },
              {
                "name": "Export the selected Xcode to Make",
                "run": "set -euo pipefail\necho \"ORLIX_PINNED_DEVELOPER_DIR=$(xcode-select -p)\" >> \"$GITHUB_ENV\"\ntest \"$(xcodebuild -version | head -n 1)\" = \"Xcode 26.6\"\ntest \"$(xcodebuild -version | sed -n '2p')\" = \"Build version 17F113\"\n"
              },
              {
                "name": "Run Make-owned cache GC",
                "run": "make __bazel-gc"
              }
            ]
          }
        }
      }
    },
    ".github/workflows/bazel-lock-proposal.yml": {
      "source_sha256": "ea5d97bd704e9b9cb86aba647c18f5a2a9deb0aaab959f4d8eeaa17e4c11b9ba",
      "workflow": {
        "name": "Bazel lock proposal",
        "on": {
          "workflow_dispatch": {
            "inputs": {
              "uapi_run_id": {
                "description": "Successful uapi promotion run for this commit",
                "required": true,
                "type": "string"
              },
              "mlibc_run_id": {
                "description": "Successful mlibc promotion run for this commit",
                "required": true,
                "type": "string"
              },
              "rootfs_run_id": {
                "description": "Successful rootfs promotion run for this commit",
                "required": true,
                "type": "string"
              },
              "kernel_release_iphoneos_run_id": {
                "description": "Successful kernel-release-iphoneos promotion run for this commit",
                "required": true,
                "type": "string"
              },
              "kernel_release_iphonesimulator_run_id": {
                "description": "Successful kernel-release-iphonesimulator promotion run for this commit",
                "required": true,
                "type": "string"
              },
              "kernel_development_iphoneos_run_id": {
                "description": "Successful kernel-development-iphoneos promotion run for this commit",
                "required": true,
                "type": "string"
              },
              "kernel_development_iphonesimulator_run_id": {
                "description": "Successful kernel-development-iphonesimulator promotion run for this commit",
                "required": true,
                "type": "string"
              }
            }
          }
        },
        "permissions": {
          "contents": "read",
          "actions": "write"
        },
        "concurrency": {
          "group": "bazel-lock-proposal",
          "cancel-in-progress": false
        },
        "jobs": {
          "derail-watchdog": {
            "name": "Cancel if derailed",
            "runs-on": "ubuntu-latest",
            "timeout-minutes": 12,
            "permissions": {
              "actions": "write"
            },
            "steps": [
              {
                "name": "Cancel when macos-26 stays queued",
                "env": {
                  "GH_TOKEN": "${{ github.token }}"
                },
                "run": "set -euo pipefail\nfor _ in $(seq 1 20); do\n  job_state=\"$(gh api \"repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}/jobs\" --jq '.jobs[] | select(.name == \"Write lock proposal\") | .status' | head -n 1)\"\n  case \"$job_state\" in\n    in_progress|completed)\n      echo \"macos-26 job is $job_state\"\n      exit 0\n      ;;\n  esac\n  sleep 30\ndone\ngh run cancel \"${GITHUB_RUN_ID}\" --repo \"${GITHUB_REPOSITORY}\"\necho \"cancelled: macos-26 job still queued after 10 minutes\"\nexit 1\n"
              }
            ]
          },
          "lock-proposal": {
            "name": "Write lock proposal",
            "if": "github.ref == 'refs/heads/main' && github.repository == 'rudironsoni/Orlix'",
            "permissions": {
              "contents": "read",
              "actions": "read",
              "packages": "read"
            },
            "runs-on": "macos-26",
            "environment": "bazel-promotion",
            "timeout-minutes": 20,
            "steps": [
              {
                "name": "Check out the exact commit",
                "timeout-minutes": 5,
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "persist-credentials": false
                }
              },
              {
                "name": "Select Xcode 26.6",
                "timeout-minutes": 5,
                "uses": "maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90",
                "with": {
                  "xcode-version": "26.6"
                }
              },
              {
                "name": "Export the selected Xcode to Make",
                "timeout-minutes": 1,
                "run": "set -euo pipefail\necho \"ORLIX_PINNED_DEVELOPER_DIR=$(xcode-select -p)\" >> \"$GITHUB_ENV\"\ntest \"$(xcodebuild -version | head -n 1)\" = \"Xcode 26.6\"\ntest \"$(xcodebuild -version | sed -n '2p')\" = \"Build version 17F113\"\n"
              },
              {
                "name": "Verify promotion run provenance",
                "env": {
                  "GH_TOKEN": "${{ github.token }}",
                  "UAPI_RUN_ID": "${{ inputs.uapi_run_id }}",
                  "MLIBC_RUN_ID": "${{ inputs.mlibc_run_id }}",
                  "ROOTFS_RUN_ID": "${{ inputs.rootfs_run_id }}",
                  "KERNEL_RELEASE_IPHONEOS_RUN_ID": "${{ inputs.kernel_release_iphoneos_run_id }}",
                  "KERNEL_RELEASE_IPHONESIMULATOR_RUN_ID": "${{ inputs.kernel_release_iphonesimulator_run_id }}",
                  "KERNEL_DEVELOPMENT_IPHONEOS_RUN_ID": "${{ inputs.kernel_development_iphoneos_run_id }}",
                  "KERNEL_DEVELOPMENT_IPHONESIMULATOR_RUN_ID": "${{ inputs.kernel_development_iphonesimulator_run_id }}"
                },
                "run": "set -euo pipefail\nfor run_id in \"$UAPI_RUN_ID\" \"$MLIBC_RUN_ID\" \"$ROOTFS_RUN_ID\" \\\n  \"$KERNEL_RELEASE_IPHONEOS_RUN_ID\" \"$KERNEL_RELEASE_IPHONESIMULATOR_RUN_ID\" \\\n  \"$KERNEL_DEVELOPMENT_IPHONEOS_RUN_ID\" \"$KERNEL_DEVELOPMENT_IPHONESIMULATOR_RUN_ID\"; do\n  [[ \"$run_id\" =~ ^[0-9]+$ ]] || { echo \"invalid promotion run ID\" >&2; exit 1; }\n  gh run view \"$run_id\" --repo \"$GITHUB_REPOSITORY\" --json conclusion,headBranch,headSha,workflowName,event > \"$RUNNER_TEMP/promotion-run.json\"\n  jq -e --arg sha \"$GITHUB_SHA\" '.conclusion == \"success\" and .headBranch == \"main\" and .headSha == $sha and .workflowName == \"Bazel promote\" and .event == \"workflow_dispatch\"' \"$RUNNER_TEMP/promotion-run.json\"\ndone\n"
              },
              {
                "name": "Download signed uapi proposal",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "signed-uapi-${{ github.sha }}",
                  "path": "Build/Bazel/promote/uapi",
                  "run-id": "${{ inputs.uapi_run_id }}",
                  "github-token": "${{ github.token }}"
                }
              },
              {
                "name": "Download signed mlibc proposal",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "signed-mlibc-${{ github.sha }}",
                  "path": "Build/Bazel/promote/mlibc",
                  "run-id": "${{ inputs.mlibc_run_id }}",
                  "github-token": "${{ github.token }}"
                }
              },
              {
                "name": "Download signed rootfs proposal",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "signed-rootfs-${{ github.sha }}",
                  "path": "Build/Bazel/promote/rootfs",
                  "run-id": "${{ inputs.rootfs_run_id }}",
                  "github-token": "${{ github.token }}"
                }
              },
              {
                "name": "Download signed kernel release iphoneos proposal",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "signed-kernel-release-iphoneos-${{ github.sha }}",
                  "path": "Build/Bazel/promote/kernel-release-iphoneos",
                  "run-id": "${{ inputs.kernel_release_iphoneos_run_id }}",
                  "github-token": "${{ github.token }}"
                }
              },
              {
                "name": "Download signed kernel release iphonesimulator proposal",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "signed-kernel-release-iphonesimulator-${{ github.sha }}",
                  "path": "Build/Bazel/promote/kernel-release-iphonesimulator",
                  "run-id": "${{ inputs.kernel_release_iphonesimulator_run_id }}",
                  "github-token": "${{ github.token }}"
                }
              },
              {
                "name": "Download signed kernel development iphoneos proposal",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "signed-kernel-development-iphoneos-${{ github.sha }}",
                  "path": "Build/Bazel/promote/kernel-development-iphoneos",
                  "run-id": "${{ inputs.kernel_development_iphoneos_run_id }}",
                  "github-token": "${{ github.token }}"
                }
              },
              {
                "name": "Download signed kernel development iphonesimulator proposal",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "signed-kernel-development-iphonesimulator-${{ github.sha }}",
                  "path": "Build/Bazel/promote/kernel-development-iphonesimulator",
                  "run-id": "${{ inputs.kernel_development_iphonesimulator_run_id }}",
                  "github-token": "${{ github.token }}"
                }
              },
              {
                "name": "Configure signature verification",
                "env": {
                  "ORLIX_COSIGN_PUB": "${{ vars.ORLIX_COSIGN_PUB }}",
                  "ORLIX_ORAS_REGISTRY_CONFIG": "${{ runner.temp }}/orlix-registry.json",
                  "GITHUB_TOKEN": "${{ github.token }}"
                },
                "run": "set -euo pipefail\ntest -f \"$ORLIX_COSIGN_PUB\" || { echo \"ORLIX_COSIGN_PUB must name the trusted public key file\" >&2; exit 1; }\nbrew list cosign >/dev/null 2>&1 || brew install cosign\nbrew list oras >/dev/null 2>&1 || brew install oras\nprintf '%s\\n' \"$GITHUB_TOKEN\" | oras login ghcr.io --registry-config \"$ORLIX_ORAS_REGISTRY_CONFIG\" -u \"$GITHUB_ACTOR\" --password-stdin\n"
              },
              {
                "name": "Write the signed lock proposal without mutating artifacts.lock.json",
                "timeout-minutes": 10,
                "env": {
                  "ORLIX_COSIGN_PUB": "${{ vars.ORLIX_COSIGN_PUB }}",
                  "ORLIX_ORAS_REGISTRY_CONFIG": "${{ runner.temp }}/orlix-registry.json"
                },
                "run": "make __bazel-lock-proposal"
              },
              {
                "name": "Store the lock proposal",
                "if": "always()",
                "timeout-minutes": 5,
                "uses": "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
                "with": {
                  "name": "buildset-lock-proposal-${{ github.sha }}",
                  "path": "Build/Bazel/promote/buildset-lock-proposal.json",
                  "if-no-files-found": "error",
                  "retention-days": 14
                }
              }
            ]
          }
        }
      }
    },
    ".github/workflows/bazel-nightly.yml": {
      "source_sha256": "d46ee2d951c12ec6084234274dcc6b7bc7808b6ed37834111cde0ae7f1d86283",
      "workflow": {
        "name": "Bazel nightly",
        "on": {
          "workflow_dispatch": null,
          "schedule": [
            {
              "cron": "17 4 * * *"
            }
          ]
        },
        "permissions": {
          "contents": "read",
          "packages": "read"
        },
        "concurrency": {
          "group": "bazel-nightly",
          "cancel-in-progress": true
        },
        "jobs": {
          "reconstruct": {
            "name": "Verify source reconstruction",
            "runs-on": "macos-26",
            "timeout-minutes": 180,
            "steps": [
              {
                "name": "Check out the exact commit",
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "persist-credentials": false
                }
              },
              {
                "name": "Select Xcode 26.6",
                "uses": "maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90",
                "with": {
                  "xcode-version": "26.6"
                }
              },
              {
                "name": "Install declared build tools",
                "run": "brew bundle --file Brewfile"
              },
              {
                "name": "Export the selected Xcode to Make",
                "run": "set -euo pipefail\necho \"ORLIX_PINNED_DEVELOPER_DIR=$(xcode-select -p)\" >> \"$GITHUB_ENV\"\ntest \"$(xcodebuild -version | head -n 1)\" = \"Xcode 26.6\"\ntest \"$(xcodebuild -version | sed -n '2p')\" = \"Build version 17F113\"\n"
              },
              {
                "name": "Run Make-owned matrix check",
                "run": "make __bazel-matrix-check"
              },
              {
                "name": "Reconstruct the signed buildset from source",
                "env": {
                  "ORLIX_COSIGN_PUB": "${{ vars.ORLIX_COSIGN_PUB }}",
                  "ORLIX_ORAS_REGISTRY_CONFIG": "${{ runner.temp }}/orlix-registry.json",
                  "GITHUB_TOKEN": "${{ github.token }}"
                },
                "run": "set -euo pipefail\ntest -n \"$ORLIX_COSIGN_PUB\" || { echo \"ORLIX_COSIGN_PUB is required\" >&2; exit 1; }\nbrew list cosign >/dev/null 2>&1 || brew install cosign\nbrew list oras >/dev/null 2>&1 || brew install oras\nprintf '%s\\n' \"$GITHUB_TOKEN\" | oras login ghcr.io --registry-config \"$ORLIX_ORAS_REGISTRY_CONFIG\" -u \"$GITHUB_ACTOR\" --password-stdin\nmake __bazel-reconstruct-source\n"
              },
              {
                "name": "Run Make-owned cache GC",
                "run": "make __bazel-gc"
              }
            ]
          }
        }
      }
    },
    ".github/workflows/bazel-promote.yml": {
      "source_sha256": "9e9500dd3d12fe73b63c5d4ed6a802d6a7331ca1e83afac983c90a26886854ba",
      "workflow": {
        "name": "Bazel promote",
        "on": {
          "workflow_dispatch": {
            "inputs": {
              "component": {
                "description": "Private component to dual-build and compare",
                "required": true,
                "type": "choice",
                "options": [
                  "uapi",
                  "mlibc",
                  "rootfs",
                  "kernel-release-iphoneos",
                  "kernel-release-iphonesimulator",
                  "kernel-development-iphoneos",
                  "kernel-development-iphonesimulator"
                ]
              }
            }
          }
        },
        "permissions": {
          "contents": "read",
          "actions": "write",
          "packages": "write"
        },
        "concurrency": {
          "group": "bazel-promote-${{ inputs.component }}",
          "cancel-in-progress": false
        },
        "jobs": {
          "derail-watchdog": {
            "name": "Cancel if derailed",
            "runs-on": "ubuntu-latest",
            "timeout-minutes": 12,
            "permissions": {
              "actions": "write"
            },
            "steps": [
              {
                "name": "Cancel when macos-26 stays queued",
                "env": {
                  "GH_TOKEN": "${{ github.token }}"
                },
                "run": "set -euo pipefail\nfor _ in $(seq 1 20); do\n  job_status=\"$(gh api \"repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}/jobs\" --jq '.jobs[] | select(.name == \"Dual-build promote\") | .status' | head -n 1)\"\n  case \"$job_status\" in\n    in_progress|completed)\n      echo \"macos-26 job is $job_status\"\n      exit 0\n      ;;\n  esac\n  sleep 30\ndone\ngh run cancel \"${GITHUB_RUN_ID}\" --repo \"${GITHUB_REPOSITORY}\"\necho \"cancelled: macos-26 job still queued after 10 minutes\"\nexit 1\n"
              }
            ]
          },
          "promote": {
            "name": "Dual-build promote",
            "if": "github.ref == 'refs/heads/main' && github.repository == 'rudironsoni/Orlix'",
            "runs-on": "macos-26",
            "permissions": {
              "contents": "read",
              "packages": "write"
            },
            "environment": "bazel-promotion",
            "timeout-minutes": 360,
            "steps": [
              {
                "name": "Check out the exact commit",
                "timeout-minutes": 5,
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "persist-credentials": false
                }
              },
              {
                "name": "Select Xcode 26.6",
                "timeout-minutes": 5,
                "uses": "maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90",
                "with": {
                  "xcode-version": "26.6"
                }
              },
              {
                "name": "Install declared build tools",
                "run": "brew bundle --file Brewfile"
              },
              {
                "name": "Export the selected Xcode to Make",
                "timeout-minutes": 1,
                "run": "set -euo pipefail\necho \"ORLIX_PINNED_DEVELOPER_DIR=$(xcode-select -p)\" >> \"$GITHUB_ENV\"\ntest \"$(xcodebuild -version | head -n 1)\" = \"Xcode 26.6\"\ntest \"$(xcodebuild -version | sed -n '2p')\" = \"Build version 17F113\"\n"
              },
              {
                "name": "Dual-build without action cache",
                "timeout-minutes": 350,
                "run": "make __bazel-promote-${{ inputs.component }}"
              },
              {
                "name": "Sign and publish to GHCR",
                "timeout-minutes": 20,
                "env": {
                  "ORLIX_COSIGN_KEY": "${{ secrets.ORLIX_COSIGN_KEY }}",
                  "ORLIX_COSIGN_KEY_PASSWORD": "${{ secrets.ORLIX_COSIGN_KEY_PASSWORD }}",
                  "ORLIX_ORAS_REGISTRY_CONFIG": "${{ runner.temp }}/orlix-registry.json",
                  "GITHUB_TOKEN": "${{ secrets.GITHUB_TOKEN }}"
                },
                "run": "set -euo pipefail\nif [ -z \"${ORLIX_COSIGN_KEY}\" ]; then\n  echo \"ORLIX_COSIGN_KEY is required; promotion failed\"\n  exit 1\nfi\nbrew list cosign >/dev/null 2>&1 || brew install cosign\nbrew list oras >/dev/null 2>&1 || brew install oras\nkey_path=\"${ORLIX_COSIGN_KEY#file://}\"\nif [ ! -f \"$key_path\" ]; then\n  key_path=\"${RUNNER_TEMP}/orlix-cosign.key\"\n  printf '%s\\n' \"$ORLIX_COSIGN_KEY\" > \"$key_path\"\n  chmod 600 \"$key_path\"\nfi\nexport ORLIX_COSIGN_KEY=\"file://${key_path}\"\nexport COSIGN_PASSWORD=\"${ORLIX_COSIGN_KEY_PASSWORD}\"\ncosign public-key --key \"$key_path\" > \"$key_path.pub\"\nexport ORLIX_COSIGN_PUB=\"$key_path.pub\"\nprintf '%s\\n' \"$GITHUB_TOKEN\" | oras login ghcr.io --registry-config \"$ORLIX_ORAS_REGISTRY_CONFIG\" -u \"${GITHUB_ACTOR}\" --password-stdin\nmake __bazel-publish-${{ inputs.component }}\n"
              },
              {
                "name": "Store the verified signed component proposal",
                "uses": "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
                "with": {
                  "name": "signed-${{ inputs.component }}-${{ github.sha }}",
                  "path": "Build/Bazel/promote/${{ inputs.component }}/${{ inputs.component }}-signed.json",
                  "if-no-files-found": "error",
                  "retention-days": 14
                }
              }
            ]
          }
        }
      }
    },
    ".github/workflows/grok-pr-review.yml": {
      "source_sha256": "73f77368b853f53a3f441afe358363f1ec6bfbddcaf7b05cc091ab01d917bc27",
      "workflow": {
        "name": "Grok PR Review",
        "on": {
          "workflow_dispatch": null
        },
        "permissions": {
          "contents": "read",
          "pull-requests": "write"
        },
        "concurrency": {
          "group": "grok-review-${{ github.event.pull_request.number }}",
          "cancel-in-progress": true
        },
        "jobs": {
          "review": {
            "if": "${{ !github.event.pull_request.draft\n    && github.event.pull_request.head.repo.full_name == github.repository }}",
            "runs-on": "ubuntu-latest",
            "env": {
              "HAS_GROK_AUTH": "${{ secrets.GROK_AUTH_JSON != '' }}"
            },
            "steps": [
              {
                "name": "Skip when GROK_AUTH_JSON is unset",
                "if": "${{ env.HAS_GROK_AUTH != 'true' }}",
                "run": "echo \"GROK_AUTH_JSON is unset; skipping Grok review.\""
              },
              {
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "if": "${{ env.HAS_GROK_AUTH == 'true' }}",
                "with": {
                  "ref": "${{ github.event.pull_request.head.sha }}"
                }
              },
              {
                "name": "Restore trusted reviewer policy from the base revision",
                "if": "${{ env.HAS_GROK_AUTH == 'true' }}",
                "env": {
                  "BASE_SHA": "${{ github.event.pull_request.base.sha }}"
                },
                "run": "git fetch --depth 1 origin \"$BASE_SHA\"\ngit checkout \"$BASE_SHA\" -- AGENTS.md CLAUDE.md\n"
              },
              {
                "uses": "0xr3ngar/grok-build-review-action@eded30018cdee4e83dfca14d18f292b860c30cdd",
                "if": "${{ env.HAS_GROK_AUTH == 'true' }}",
                "with": {
                  "grok_auth_json": "${{ secrets.GROK_AUTH_JSON }}",
                  "roast_level": "professional",
                  "custom_instructions": "Follow AGENTS.md from the pull request base revision. Orlix compiles\nupstream Linux into an iOS-hosted kernel. Do not suggest edits to\ngenerated trees under Build/. Do not move Linux policy into\nOrlixHostAdapter. Do not invent a parallel OrlixKit API. Fail loud\nwhen evidence is missing.\n"
                }
              }
            ]
          }
        }
      }
    },
    ".github/workflows/testflight-beta.yml": {
      "source_sha256": "85d274791df347b82a44c8449ab772f99fc98b3e5a6605f6e721125eeb877fc9",
      "workflow": {
        "name": "TestFlight beta",
        "on": {
          "push": {
            "tags": [
              "ios-v*-b*"
            ]
          }
        },
        "permissions": {
          "contents": "read"
        },
        "concurrency": {
          "group": "testflight-beta-${{ github.ref_name }}",
          "cancel-in-progress": false
        },
        "jobs": {
          "build-and-submit": {
            "name": "Build and submit beta",
            "runs-on": "macos-26",
            "environment": "testflight-internal",
            "timeout-minutes": 180,
            "env": {
              "ORLIX_RELEASE_REPOSITORY": "${{ github.repository }}",
              "ORLIX_RELEASE_TAG": "${{ github.ref_name }}",
              "ORLIX_RELEASE_COMMIT": "${{ github.sha }}",
              "ORLIX_RELEASE_RUN_ID": "${{ github.run_id }}",
              "ORLIX_RELEASE_XCODE_VERSION": "26.6",
              "ORLIX_RELEASE_UPLOAD_BACKEND": "appstore-api",
              "ORLIX_DEVELOPMENT_TEAM": "${{ vars.APPLE_TEAM_ID }}",
              "ORLIX_ASC_API_KEY_ID": "${{ vars.APPSTORE_API_KEY_ID }}",
              "ORLIX_ASC_API_ISSUER_ID": "${{ vars.APPSTORE_ISSUER_ID }}",
              "ORLIX_TESTFLIGHT_INTERNAL_GROUP": "${{ vars.TESTFLIGHT_INTERNAL_GROUP }}",
              "ORLIX_BETA_EXPORT_OPTIONS_PLIST": "${{ github.workspace }}/Build/Release/ExportOptions.plist",
              "ORLIX_ANALYTICS_ENABLED": "NO",
              "ORLIX_OBSERVABILITY_ENABLED": "NO"
            },
            "steps": [
              {
                "name": "Check out the release tag",
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "fetch-depth": 0
                }
              },
              {
                "name": "Fetch the protected release base",
                "run": "git fetch --no-tags origin main:refs/remotes/origin/main"
              },
              {
                "name": "Select Xcode 26.6",
                "uses": "maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90",
                "with": {
                  "xcode-version": "26.6"
                }
              },
              {
                "name": "Export the selected Xcode to Make",
                "run": "set -euo pipefail\necho \"ORLIX_PINNED_DEVELOPER_DIR=$(xcode-select -p)\" >> \"$GITHUB_ENV\"\ntest \"$(xcodebuild -version | head -n 1)\" = \"Xcode 26.6\"\ntest \"$(xcodebuild -version | sed -n '2p')\" = \"Build version 17F113\"\n"
              },
              {
                "name": "Install the Metal toolchain",
                "run": "xcodebuild -downloadComponent MetalToolchain"
              },
              {
                "name": "Set up Ruby and pinned Fastlane",
                "uses": "ruby/setup-ruby@95ef2b042f9d7a56d8268cba8559e2842e2ad01b",
                "with": {
                  "ruby-version": "3.4.8",
                  "bundler-cache": true
                }
              },
              {
                "name": "Install build tools",
                "run": "brew bundle --file Brewfile"
              },
              {
                "name": "Check runner capacity",
                "run": "set -euo pipefail\ndf -h .\navailable_kib=\"$(df -Pk . | awk 'NR == 2 { print $4 }')\"\ntest \"$available_kib\" -ge 10485760 || {\n  echo \"At least 10 GiB of free disk is required\" >&2\n  exit 1\n}\n"
              },
              {
                "name": "Materialize App Store Connect credentials",
                "env": {
                  "APPSTORE_API_PRIVATE_KEY": "${{ secrets.APPSTORE_API_PRIVATE_KEY }}"
                },
                "run": "set -euo pipefail\ntest -n \"$APPSTORE_API_PRIVATE_KEY\"\numask 077\nexport ORLIX_FASTLANE_API_KEY_PATH=\"$RUNNER_TEMP/appstore-api-key.json\"\nexport ORLIX_ASC_API_KEY_PATH=\"$RUNNER_TEMP/AuthKey.p8\"\nprintf '%s' \"$APPSTORE_API_PRIVATE_KEY\" > \"$ORLIX_ASC_API_KEY_PATH\"\nruby -rjson -e 'File.write(ENV.fetch(\"ORLIX_FASTLANE_API_KEY_PATH\"), JSON.pretty_generate({key_id: ENV.fetch(\"ORLIX_ASC_API_KEY_ID\"), issuer_id: ENV.fetch(\"ORLIX_ASC_API_ISSUER_ID\"), key_filepath: ENV.fetch(\"ORLIX_ASC_API_KEY_PATH\"), in_house: false}))'\necho \"ORLIX_FASTLANE_API_KEY_PATH=$ORLIX_FASTLANE_API_KEY_PATH\" >> \"$GITHUB_ENV\"\necho \"ORLIX_ASC_API_KEY_PATH=$ORLIX_ASC_API_KEY_PATH\" >> \"$GITHUB_ENV\"\n"
              },
              {
                "name": "Import distribution certificate",
                "uses": "Apple-Actions/import-codesign-certs@5142e029c445c10ffc7149d172e540235a065466",
                "with": {
                  "p12-file-base64": "${{ secrets.APPLE_DISTRIBUTION_CERTIFICATE_P12_BASE64 }}",
                  "p12-password": "${{ secrets.APPLE_DISTRIBUTION_CERTIFICATE_PASSWORD }}"
                }
              },
              {
                "name": "Download app provisioning profile",
                "uses": "Apple-Actions/download-provisioning-profiles@2126b5f86a0e2863cbf4d2d312112b22b943a594",
                "with": {
                  "bundle-id": "com.rudironsoni.Orlix",
                  "profile-type": "IOS_APP_STORE",
                  "issuer-id": "${{ vars.APPSTORE_ISSUER_ID }}",
                  "api-key-id": "${{ vars.APPSTORE_API_KEY_ID }}",
                  "api-private-key": "${{ secrets.APPSTORE_API_PRIVATE_KEY }}"
                }
              },
              {
                "name": "Download Live Activity provisioning profile",
                "uses": "Apple-Actions/download-provisioning-profiles@2126b5f86a0e2863cbf4d2d312112b22b943a594",
                "with": {
                  "bundle-id": "com.rudironsoni.Orlix.live-activity",
                  "profile-type": "IOS_APP_STORE",
                  "issuer-id": "${{ vars.APPSTORE_ISSUER_ID }}",
                  "api-key-id": "${{ vars.APPSTORE_API_KEY_ID }}",
                  "api-private-key": "${{ secrets.APPSTORE_API_PRIVATE_KEY }}"
                }
              },
              {
                "name": "Build pinned native vendor artifacts",
                "run": "make build type=vendor vendor=all"
              },
              {
                "name": "Validate tag and release inputs",
                "run": "make __release-tag-check beta-prerequisites"
              },
              {
                "name": "Select an iOS simulator",
                "run": "set -euo pipefail\nsimulator_id=\"$(xcrun simctl list devices available -j | jq -r '[.devices[][] | select(.name | startswith(\"iPhone\"))][0].udid')\"\ntest -n \"$simulator_id\" -a \"$simulator_id\" != null\necho \"ORLIX_BETA_SIMULATOR_ID=$simulator_id\" >> \"$GITHUB_ENV\"\n"
              },
              {
                "name": "Run the beta simulator gate",
                "run": "make beta-simulator-gate"
              },
              {
                "name": "Archive and export the exact build",
                "run": "set -euo pipefail\nmake beta-export-options\nmake beta-archive\nmake beta-export-archive\nmake beta-validate-export\n"
              },
              {
                "name": "Enforce beta upload eligibility",
                "run": "make beta-upload-prerequisites"
              },
              {
                "name": "Upload and wait for TestFlight processing",
                "uses": "Apple-Actions/upload-testflight-build@5e75ff58276689011512ba87a381d93dc67dbcf8",
                "with": {
                  "app-path": "Build/Release/Export/Orlix.ipa",
                  "app-type": "ios",
                  "issuer-id": "${{ vars.APPSTORE_ISSUER_ID }}",
                  "api-key-id": "${{ vars.APPSTORE_API_KEY_ID }}",
                  "api-private-key": "${{ secrets.APPSTORE_API_PRIVATE_KEY }}",
                  "backend": "appstore-api",
                  "uses-non-exempt-encryption": false,
                  "wait-for-processing": true
                }
              },
              {
                "name": "Assign the processed build to internal testers",
                "run": "make beta-distribute"
              },
              {
                "name": "Write the immutable beta release report",
                "run": "make beta-release-report"
              },
              {
                "name": "Store beta evidence",
                "uses": "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
                "with": {
                  "name": "orlix-testflight-${{ github.ref_name }}",
                  "path": "Build/AgentHarness/orlix-release/release.json\nBuild/Release/release-identity.json\nBuild/Release/build-number\nBuild/Release/Export/Orlix.ipa\n",
                  "if-no-files-found": "error",
                  "retention-days": 30
                }
              }
            ]
          }
        }
      }
    }
  }
}
