{
  "schema": 1,
  "purpose": "Resolved workflow trigger, permission, environment, job, step, action, artifact, and release-operation inventory.",
  "workflows": {
    ".github/workflows/app-store-review.yml": {
      "source_sha256": "38afaa5c6995d1564b0c2111edbe62b9fbdfd72aa397bd30577398240b36ad07",
      "workflow": {
        "name": "Promote TestFlight beta to App Review",
        "on": {
          "workflow_dispatch": {
            "inputs": {
              "beta_tag": {
                "description": "Protected beta tag, for example ios-v0.1-b42",
                "required": true,
                "type": "string"
              }
            }
          }
        },
        "permissions": {
          "actions": "read",
          "contents": "read"
        },
        "concurrency": {
          "group": "app-store-review-${{ inputs.beta_tag }}",
          "cancel-in-progress": false
        },
        "jobs": {
          "submit-for-review": {
            "name": "Submit exact beta for App Review",
            "runs-on": "ubuntu-24.04",
            "environment": "app-store-review",
            "timeout-minutes": 30,
            "env": {
              "ORLIX_RELEASE_REPOSITORY": "${{ github.repository }}",
              "ORLIX_RELEASE_TAG": "${{ inputs.beta_tag }}",
              "ORLIX_RELEASE_REPORT_INPUT": "${{ github.workspace }}/beta-evidence/AgentHarness/orlix-release/release.json"
            },
            "steps": [
              {
                "name": "Check out the protected beta tag",
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "ref": "refs/tags/${{ inputs.beta_tag }}",
                  "fetch-depth": 0
                }
              },
              {
                "name": "Resolve the tag and successful beta run",
                "id": "beta",
                "env": {
                  "GH_TOKEN": "${{ github.token }}"
                },
                "run": "set -euo pipefail\ngit fetch --no-tags origin main:refs/remotes/origin/main\ncommit=\"$(git rev-list -n 1 \"refs/tags/$ORLIX_RELEASE_TAG\")\"\ntest -n \"$commit\"\nrun_id=\"$(gh api \"repos/$GITHUB_REPOSITORY/actions/workflows/testflight-beta.yml/runs?event=push&status=success&head_sha=$commit\" --jq '.workflow_runs[0].id // empty')\"\ntest -n \"$run_id\" || { echo \"No successful beta workflow exists for $ORLIX_RELEASE_TAG at $commit\" >&2; exit 1; }\necho \"commit=$commit\" >> \"$GITHUB_OUTPUT\"\necho \"run_id=$run_id\" >> \"$GITHUB_OUTPUT\"\necho \"ORLIX_RELEASE_COMMIT=$commit\" >> \"$GITHUB_ENV\"\necho \"ORLIX_RELEASE_RUN_ID=$run_id\" >> \"$GITHUB_ENV\"\n"
              },
              {
                "name": "Download exact beta evidence",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "orlix-testflight-${{ inputs.beta_tag }}",
                  "path": "beta-evidence",
                  "github-token": "${{ github.token }}",
                  "run-id": "${{ steps.beta.outputs.run_id }}"
                }
              },
              {
                "name": "Set up Ruby and pinned Fastlane",
                "uses": "ruby/setup-ruby@95ef2b042f9d7a56d8268cba8559e2842e2ad01b",
                "with": {
                  "ruby-version": "3.4.8",
                  "bundler-cache": true
                }
              },
              {
                "name": "Materialize App Store Connect credentials",
                "env": {
                  "APPSTORE_API_KEY_ID": "${{ vars.APPSTORE_API_KEY_ID }}",
                  "APPSTORE_ISSUER_ID": "${{ vars.APPSTORE_ISSUER_ID }}",
                  "APPSTORE_API_PRIVATE_KEY": "${{ secrets.APPSTORE_API_PRIVATE_KEY }}"
                },
                "run": "set -euo pipefail\ntest -n \"$APPSTORE_API_PRIVATE_KEY\"\numask 077\nprivate_key=\"$RUNNER_TEMP/AuthKey.p8\"\nexport ORLIX_FASTLANE_API_KEY_PATH=\"$RUNNER_TEMP/appstore-api-key.json\"\nprintf '%s' \"$APPSTORE_API_PRIVATE_KEY\" > \"$private_key\"\nexport private_key\nruby -rjson -e 'File.write(ENV.fetch(\"ORLIX_FASTLANE_API_KEY_PATH\"), JSON.pretty_generate({key_id: ENV.fetch(\"APPSTORE_API_KEY_ID\"), issuer_id: ENV.fetch(\"APPSTORE_ISSUER_ID\"), key_filepath: ENV.fetch(\"private_key\"), in_house: false}))'\necho \"ORLIX_FASTLANE_API_KEY_PATH=$ORLIX_FASTLANE_API_KEY_PATH\" >> \"$GITHUB_ENV\"\n"
              },
              {
                "name": "Validate and submit the exact beta",
                "run": "make app-store-promote"
              }
            ]
          }
        }
      }
    },
    ".github/workflows/bazel-gc.yml": {
      "source_sha256": "449321a3ab6d1dbd467c6fb91caf738ea7f6a22f4203fc818759dfa6b0e18ac2",
      "workflow": {
        "name": "Bazel cache garbage collection",
        "on": {
          "workflow_dispatch": null,
          "schedule": [
            {
              "cron": "17 5 * * 1"
            }
          ]
        },
        "permissions": {
          "contents": "read"
        },
        "concurrency": {
          "group": "bazel-gc",
          "cancel-in-progress": true
        },
        "jobs": {
          "gc": {
            "name": "Bound local cache growth",
            "runs-on": "macos-26",
            "timeout-minutes": 30,
            "steps": [
              {
                "name": "Check out the exact commit",
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "persist-credentials": false
                }
              },
              {
                "name": "Select Xcode 26.6",
                "uses": "maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90",
                "with": {
                  "xcode-version": "26.6"
                }
              },
              {
                "name": "Export the selected Xcode to Make",
                "run": "set -euo pipefail\necho \"ORLIX_PINNED_DEVELOPER_DIR=$(xcode-select -p)\" >> \"$GITHUB_ENV\"\ntest \"$(xcodebuild -version | head -n 1)\" = \"Xcode 26.6\"\ntest \"$(xcodebuild -version | sed -n '2p')\" = \"Build version 17F113\"\n"
              },
              {
                "name": "Run Make-owned cache GC",
                "run": "make __bazel-gc"
              }
            ]
          }
        }
      }
    },
    ".github/workflows/bazel-lock-proposal.yml": {
      "source_sha256": "53d25d7436e9cd35a30b87b9c6f41ad12aa62072af62e417309d76162a08cfb1",
      "workflow": {
        "name": "Bazel lock proposal",
        "on": {
          "workflow_dispatch": {
            "inputs": {
              "uapi_run_id": {
                "description": "Successful uapi promotion run for this commit",
                "required": true,
                "type": "string"
              },
              "mlibc_run_id": {
                "description": "Successful mlibc promotion run for this commit",
                "required": true,
                "type": "string"
              },
              "rootfs_run_id": {
                "description": "Successful rootfs promotion run for this commit",
                "required": true,
                "type": "string"
              }
            }
          }
        },
        "permissions": {
          "contents": "read",
          "actions": "write"
        },
        "concurrency": {
          "group": "bazel-lock-proposal",
          "cancel-in-progress": false
        },
        "jobs": {
          "derail-watchdog": {
            "name": "Cancel if derailed",
            "runs-on": "ubuntu-latest",
            "timeout-minutes": 12,
            "permissions": {
              "actions": "write"
            },
            "steps": [
              {
                "name": "Cancel when macos-26 stays queued",
                "env": {
                  "GH_TOKEN": "${{ github.token }}"
                },
                "run": "set -euo pipefail\nfor _ in $(seq 1 20); do\n  job_state=\"$(gh api \"repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}/jobs\" --jq '.jobs[] | select(.name == \"Write lock proposal\") | .status' | head -n 1)\"\n  case \"$job_state\" in\n    in_progress|completed)\n      echo \"macos-26 job is $job_state\"\n      exit 0\n      ;;\n  esac\n  sleep 30\ndone\ngh run cancel \"${GITHUB_RUN_ID}\" --repo \"${GITHUB_REPOSITORY}\"\necho \"cancelled: macos-26 job still queued after 10 minutes\"\nexit 1\n"
              }
            ]
          },
          "lock-proposal": {
            "name": "Write lock proposal",
            "if": "github.ref == 'refs/heads/main' && github.repository == 'rudironsoni/Orlix'",
            "permissions": {
              "contents": "read",
              "actions": "read",
              "packages": "read"
            },
            "runs-on": "macos-26",
            "environment": "bazel-promotion",
            "timeout-minutes": 20,
            "steps": [
              {
                "name": "Check out the exact commit",
                "timeout-minutes": 5,
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "persist-credentials": false
                }
              },
              {
                "name": "Select Xcode 26.6",
                "timeout-minutes": 5,
                "uses": "maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90",
                "with": {
                  "xcode-version": "26.6"
                }
              },
              {
                "name": "Export the selected Xcode to Make",
                "timeout-minutes": 1,
                "run": "set -euo pipefail\necho \"ORLIX_PINNED_DEVELOPER_DIR=$(xcode-select -p)\" >> \"$GITHUB_ENV\"\ntest \"$(xcodebuild -version | head -n 1)\" = \"Xcode 26.6\"\ntest \"$(xcodebuild -version | sed -n '2p')\" = \"Build version 17F113\"\n"
              },
              {
                "name": "Verify promotion run provenance",
                "env": {
                  "GH_TOKEN": "${{ github.token }}",
                  "UAPI_RUN_ID": "${{ inputs.uapi_run_id }}",
                  "MLIBC_RUN_ID": "${{ inputs.mlibc_run_id }}",
                  "ROOTFS_RUN_ID": "${{ inputs.rootfs_run_id }}"
                },
                "run": "set -euo pipefail\nfor run_id in \"$UAPI_RUN_ID\" \"$MLIBC_RUN_ID\" \"$ROOTFS_RUN_ID\"; do\n  [[ \"$run_id\" =~ ^[0-9]+$ ]] || { echo \"invalid promotion run ID\" >&2; exit 1; }\n  gh run view \"$run_id\" --repo \"$GITHUB_REPOSITORY\" --json conclusion,headBranch,headSha,workflowName,event > \"$RUNNER_TEMP/promotion-run.json\"\n  jq -e --arg sha \"$GITHUB_SHA\" '.conclusion == \"success\" and .headBranch == \"main\" and .headSha == $sha and .workflowName == \"Bazel promote\" and .event == \"workflow_dispatch\"' \"$RUNNER_TEMP/promotion-run.json\"\ndone\n"
              },
              {
                "name": "Download signed uapi proposal",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "signed-uapi-${{ github.sha }}",
                  "path": "Build/Bazel/promote/uapi",
                  "run-id": "${{ inputs.uapi_run_id }}",
                  "github-token": "${{ github.token }}"
                }
              },
              {
                "name": "Download signed mlibc proposal",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "signed-mlibc-${{ github.sha }}",
                  "path": "Build/Bazel/promote/mlibc",
                  "run-id": "${{ inputs.mlibc_run_id }}",
                  "github-token": "${{ github.token }}"
                }
              },
              {
                "name": "Download signed rootfs proposal",
                "uses": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
                "with": {
                  "name": "signed-rootfs-${{ github.sha }}",
                  "path": "Build/Bazel/promote/rootfs",
                  "run-id": "${{ inputs.rootfs_run_id }}",
                  "github-token": "${{ github.token }}"
                }
              },
              {
                "name": "Configure signature verification",
                "env": {
                  "ORLIX_COSIGN_PUB": "${{ vars.ORLIX_COSIGN_PUB }}",
                  "ORLIX_ORAS_REGISTRY_CONFIG": "${{ runner.temp }}/orlix-registry.json",
                  "GITHUB_TOKEN": "${{ github.token }}"
                },
                "run": "set -euo pipefail\ntest -f \"$ORLIX_COSIGN_PUB\" || { echo \"ORLIX_COSIGN_PUB must name the trusted public key file\" >&2; exit 1; }\nbrew list cosign >/dev/null 2>&1 || brew install cosign\nbrew list oras >/dev/null 2>&1 || brew install oras\nprintf '%s\\n' \"$GITHUB_TOKEN\" | oras login ghcr.io --registry-config \"$ORLIX_ORAS_REGISTRY_CONFIG\" -u \"$GITHUB_ACTOR\" --password-stdin\n"
              },
              {
                "name": "Write the signed lock proposal without mutating artifacts.lock.json",
                "timeout-minutes": 10,
                "env": {
                  "ORLIX_COSIGN_PUB": "${{ vars.ORLIX_COSIGN_PUB }}",
                  "ORLIX_ORAS_REGISTRY_CONFIG": "${{ runner.temp }}/orlix-registry.json"
                },
                "run": "make __bazel-lock-proposal"
              },
              {
                "name": "Store the lock proposal",
                "if": "always()",
                "timeout-minutes": 5,
                "uses": "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
                "with": {
                  "name": "buildset-lock-proposal-${{ github.sha }}",
                  "path": "Build/Bazel/promote/buildset-lock-proposal.json",
                  "if-no-files-found": "error",
                  "retention-days": 14
                }
              }
            ]
          }
        }
      }
    },
    ".github/workflows/bazel-main.yml": {
      "source_sha256": "041a16a7a0b33b9f0015a1f872db6eabde6d0b1f79f6282a15b62f0c7b05e8c3",
      "workflow": {
        "name": "Bazel main",
        "on": {
          "push": {
            "branches": [
              "main"
            ],
            "paths": [
              "MODULE.bazel",
              "MODULE.bazel.lock",
              "bazel/**",
              "make/bazel-migration.mk",
              "artifacts.lock.json",
              ".github/workflows/bazel-pr.yml",
              ".github/workflows/bazel-promote.yml",
              ".github/workflows/bazel-gc.yml",
              ".github/workflows/bazel-main.yml",
              ".github/workflows/bazel-nightly.yml",
              ".github/workflows/bazel-lock-proposal.yml"
            ]
          }
        },
        "permissions": {
          "contents": "read"
        },
        "concurrency": {
          "group": "bazel-main-${{ github.sha }}",
          "cancel-in-progress": true
        },
        "jobs": {
          "matrix-check": {
            "name": "Bazel matrix check",
            "runs-on": "macos-26",
            "timeout-minutes": 60,
            "steps": [
              {
                "name": "Check out the exact commit",
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "persist-credentials": false
                }
              },
              {
                "name": "Select Xcode 26.6",
                "uses": "maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90",
                "with": {
                  "xcode-version": "26.6"
                }
              },
              {
                "name": "Export the selected Xcode to Make",
                "run": "set -euo pipefail\necho \"ORLIX_PINNED_DEVELOPER_DIR=$(xcode-select -p)\" >> \"$GITHUB_ENV\"\ntest \"$(xcodebuild -version | head -n 1)\" = \"Xcode 26.6\"\ntest \"$(xcodebuild -version | sed -n '2p')\" = \"Build version 17F113\"\n"
              },
              {
                "name": "Run Make-owned Bazel matrix check",
                "run": "make __bazel-matrix-check"
              }
            ]
          }
        }
      }
    },
    ".github/workflows/bazel-nightly.yml": {
      "source_sha256": "f1b5221470adbcfe8a85adbb9eca50cbdfc6620066b4b062fba32c5a0570eaa8",
      "workflow": {
        "name": "Bazel nightly",
        "on": {
          "workflow_dispatch": null,
          "schedule": [
            {
              "cron": "17 4 * * *"
            }
          ]
        },
        "permissions": {
          "contents": "read",
          "packages": "read"
        },
        "concurrency": {
          "group": "bazel-nightly",
          "cancel-in-progress": true
        },
        "jobs": {
          "reconstruct": {
            "name": "Verify source reconstruction",
            "runs-on": "macos-26",
            "timeout-minutes": 180,
            "steps": [
              {
                "name": "Check out the exact commit",
                "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
                "with": {
                  "persist-credentials": false
                }
              },
              {
                "name": "Select Xcode 26.6",
                "uses": "maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90",
                "with": {
                  "xcode-version": "26.6"
                }
              },
              {
                "name": "Export the selected Xcode to Make",
                "run": "set -euo pipefail\necho \"ORLIX_PINNED_DEVELOPER_DIR=$(xcode-select -p)\" >> \"$GITHUB_ENV\"\ntest \"$(xcodebuild -version | head -n 1)\" = \"Xcode 26.6\"\ntest \"$(xcodebuild -version | sed -n '2p')\" = \"Build version 17F113\"\n"
              },
              {
                "name": "Run Make-owned matrix check",
                "run": "make __bazel-matrix-check"
              },
              {
                "name": "Reconstruct the signed buildset from source",
                "env": {
                  "ORLIX_COSIGN_PUB": "${{ vars.ORLIX_COSIGN_PUB }}",
                  "ORLIX_ORAS_REGISTRY_CONFIG": "${{ runner.temp }}/orlix-registry.json",
                  "GITHUB_TOKEN": "${{ github.token }}"
                },
                "run": "set -euo pipefail\ntest -n \"$ORLIX_COSIGN_PUB\" || { echo \"ORLIX_COSIGN_PUB is required\" >&2; exit 1; }\nbrew list cosign >/dev/null 2>&1 || brew install cosign\nbrew list oras >/dev/null 2>&1 || brew install oras\nprintf '%s\\n' \"$GITHUB_TOKEN\" | oras login ghcr.io --registry-config \"$ORLIX_ORAS_REGISTRY_CONFIG\" -u \"$GITHUB_ACTOR\" --password-stdin\nmake __bazel-reconstruct-source\n"
              },
              {
                "name": "Run Make-owned cache GC",
                "run": "make __bazel-gc"
              }
            ]
          }
        }
      }
    },
