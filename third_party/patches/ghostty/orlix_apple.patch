 }
+
+const LibcxxAvailability = struct {
+    step: std.Build.Step,
+    compile: *std.Build.Step.Compile,
+
+    fn make(step: *std.Build.Step, options: std.Build.Step.MakeOptions) anyerror!void {
+        _ = options;
+        const self: *LibcxxAvailability = @fieldParentPtr("step", step);
+        const b = step.owner;
+        for (self.compile.root_module.link_objects.items) |obj| switch (obj) {
+            .c_source_file => |file| {
+                file.flags = prependLibcxxAvailabilityFlags(b, file.flags);
+            },
+            .c_source_files => |files| {
+                files.flags = prependLibcxxAvailabilityFlags(b, files.flags);
+            },
+            else => {},
+        };
+    }
+};
+
+fn prependLibcxxAvailabilityFlags(
+    b: *std.Build,
+    flags: []const []const u8,
+) []const []const u8 {
+    const undef_flag = "-U_LIBCPP_HAS_VENDOR_AVAILABILITY_ANNOTATIONS";
+    const def_flag = "-D_LIBCPP_HAS_VENDOR_AVAILABILITY_ANNOTATIONS=1";
+    for (flags) |flag| {
+        if (std.mem.eql(u8, flag, undef_flag)) return flags;
+    }
+    const out = b.allocator.alloc([]const u8, flags.len + 2) catch @panic("OOM");
+    out[0] = undef_flag;
+    out[1] = def_flag;
+    @memcpy(out[2..], flags);
+    return out;
+}
