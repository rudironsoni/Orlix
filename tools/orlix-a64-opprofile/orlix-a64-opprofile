#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Report AArch64 instruction-class coverage for Orlix TCTI bring-up."""

from __future__ import annotations

import argparse
import collections
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


INSTRUCTION_RE = re.compile(
    r"^\s*(?P<pc>[0-9a-fA-F]+):\s+(?P<word>[0-9a-fA-F]{8})\s+\t(?P<asm>.*)$"
)


@dataclass(frozen=True)
class Decoded:
    name: str
    supported: bool


SUPPORTED = True
UNSUPPORTED = False


def bits(value: int, shift: int, width: int) -> int:
    return (value >> shift) & ((1 << width) - 1)


def classify_load_store_variant(size: int, opc: int) -> bool:
    if opc in (0, 1):
        return True
    if opc == 2:
        return size != 3
    if opc == 3:
        return size < 2
    return False


def ror_width(value: int, rotate: int, width: int) -> int:
    mask = (1 << width) - 1
    rotate %= width
    value &= mask
    if rotate == 0:
        return value
    return ((value >> rotate) | (value << (width - rotate))) & mask


def decode_logical_immediate(is_64: bool, n: int, immr: int, imms: int) -> int | None:
    reg_width = 64 if is_64 else 32
    len_source = (n << 6) | ((~imms) & 0x3F)
    if len_source == 0:
        return None
    length = len_source.bit_length() - 1
    if not is_64 and length == 6:
        return None
    levels = (1 << length) - 1
    if (imms & levels) == levels:
        return None
    size = 1 << length
    element = (1 << ((imms & levels) + 1)) - 1
    element = ror_width(element, immr & levels, size)
    result = 0
    for offset in range(0, reg_width, size):
        result |= element << offset
    return result


def classify(word: int) -> Decoded:
    if (word & 0xFFE0001F) == 0xD4000001:
        return Decoded("svc", SUPPORTED)
    if (word & 0xFFFFF01F) == 0xD503201F:
        return Decoded("hint", SUPPORTED)
    if (word & 0x1F000000) == 0x10000000:
        return Decoded("pc-relative-address", SUPPORTED)
    if (word & 0x1F000000) == 0x11000000:
        return Decoded("add-sub-immediate", SUPPORTED)
    if (word & 0x1F200000) == 0x0B000000:
        shift = bits(word, 22, 2)
        shift_amount = bits(word, 10, 6)
        is_64 = bool(word & (1 << 31))
        if shift == 3 or (not is_64 and (shift_amount & (1 << 5))):
            return Decoded("unsupported-add-sub-shifted-register", UNSUPPORTED)
        return Decoded("add-sub-shifted-register", SUPPORTED)
    if (word & 0x1F200000) == 0x0B200000:
        amount = bits(word, 10, 3)
        if amount > 4:
            return Decoded("unsupported-add-sub-extended-register", UNSUPPORTED)
        return Decoded("add-sub-extended-register", SUPPORTED)
    if (word & 0x7C000000) == 0x14000000:
        return Decoded("unconditional-branch-immediate", SUPPORTED)
    if (word & 0xFFFFFC1F) in (0xD61F0000, 0xD63F0000, 0xD65F0000):
        return Decoded("unconditional-branch-register", SUPPORTED)
    if (word & 0x7E000000) == 0x34000000:
        return Decoded("compare-branch-immediate", SUPPORTED)
    if (word & 0x7E000000) == 0x36000000:
        return Decoded("test-branch-immediate", SUPPORTED)
    if (word & 0xFF000010) == 0x54000000:
        return Decoded("conditional-branch-immediate", SUPPORTED)
    if (word & 0x1FE00000) == 0x1A800000:
        return Decoded("conditional-select", SUPPORTED)
    if (word & 0x3A000000) == 0x28000000:
        opc = bits(word, 30, 2)
        mode = bits(word, 23, 2)
        if mode == 0 or opc not in (0, 2):
            return Decoded("unsupported-load-store-pair", UNSUPPORTED)
        return Decoded("load-store-pair", SUPPORTED)
    if (word & 0x3B000000) == 0x39000000:
        size = bits(word, 30, 2)
        opc = bits(word, 22, 2)
        if not classify_load_store_variant(size, opc):
            return Decoded("unsupported-load-store-unsigned-immediate", UNSUPPORTED)
        return Decoded("load-store-unsigned-immediate", SUPPORTED)
    if (word & 0x3B200000) == 0x38000000:
        size = bits(word, 30, 2)
        opc = bits(word, 22, 2)
        mode = bits(word, 10, 2)
        if mode == 2 or not classify_load_store_variant(size, opc):
            return Decoded("unsupported-load-store-signed-immediate", UNSUPPORTED)
        return Decoded("load-store-signed-immediate", SUPPORTED)
    if (word & 0x3B200C00) == 0x38200800:
        size = bits(word, 30, 2)
        opc = bits(word, 22, 2)
        option = bits(word, 13, 3)
        if option not in (2, 3, 6, 7) or not classify_load_store_variant(size, opc):
            return Decoded("unsupported-load-store-register-offset", UNSUPPORTED)
        return Decoded("load-store-register-offset", SUPPORTED)
    if (word & 0x1F000000) == 0x0A000000:
        opc = bits(word, 29, 2)
        shift_amount = bits(word, 10, 6)
        is_64 = bool(word & (1 << 31))
        if not is_64 and (shift_amount & (1 << 5)):
            return Decoded("unsupported-logical-shifted-register", UNSUPPORTED)
        return Decoded("logical-shifted-register", SUPPORTED)
    if (word & 0x1F800000) == 0x12000000:
        is_64 = bool(word & (1 << 31))
        n = bits(word, 22, 1)
        immr = bits(word, 16, 6)
        imms = bits(word, 10, 6)
        if decode_logical_immediate(is_64, n, immr, imms) is None:
            return Decoded("unsupported-logical-immediate", UNSUPPORTED)
        return Decoded("logical-immediate", SUPPORTED)
    if (word & 0x1F800000) == 0x12800000:
        opc = bits(word, 29, 2)
        hw = bits(word, 21, 2)
        is_64 = bool(word & (1 << 31))
        if opc == 1 or (not is_64 and (hw & 2)):
            return Decoded("unsupported-move-wide-immediate", UNSUPPORTED)
        return Decoded("move-wide-immediate", SUPPORTED)
    if (word & 0xFFF00000) in (0xD5300000, 0xD5100000):
        sysreg = bits(word, 5, 16)
        if sysreg in (0xDE82, 0xDA10):
            return Decoded("system-register", SUPPORTED)
        return Decoded("unsupported-system-register", UNSUPPORTED)

    if (word & 0x3B000000) in (0x18000000, 0x58000000, 0x98000000):
        return Decoded("load-literal", UNSUPPORTED)
    if (word & 0x1F800000) == 0x13000000:
        opc = bits(word, 29, 2)
        is_64 = bool(word & (1 << 31))
        n = bits(word, 22, 1)
        immr = bits(word, 16, 6)
        imms = bits(word, 10, 6)
        if opc == 3:
            return Decoded("unsupported-bitfield", UNSUPPORTED)
        if not is_64 and (n or (immr & (1 << 5)) or (imms & (1 << 5))):
            return Decoded("unsupported-bitfield", UNSUPPORTED)
        if is_64 and not n:
            return Decoded("unsupported-bitfield", UNSUPPORTED)
        return Decoded("bitfield", SUPPORTED)
    if (word & 0x7F800000) == 0x13800000:
        is_64 = bool(word & (1 << 31))
        n = bits(word, 22, 1)
        lsb = bits(word, 10, 6)
        if bool(n) != is_64:
            return Decoded("unsupported-extract", UNSUPPORTED)
        if not is_64 and (lsb & (1 << 5)):
            return Decoded("unsupported-extract", UNSUPPORTED)
        return Decoded("extract", SUPPORTED)
    if (word & 0x5FE00000) == 0x5AC00000:
        opcode = bits(word, 10, 6)
        if opcode == 0x04:
            return Decoded("data-processing-1source", SUPPORTED)
        return Decoded("unsupported-data-processing-1source", UNSUPPORTED)
    if (word & 0x7FE00000) == 0x1AC00000:
        opcode = bits(word, 10, 6)
        if opcode in (0x02, 0x03, 0x08, 0x09, 0x0A, 0x0B):
            return Decoded("data-processing-2source", SUPPORTED)
        return Decoded("unsupported-data-processing-2source", UNSUPPORTED)
    if word == 0xD5033F5F:
        return Decoded("exclusive-monitor-clear", SUPPORTED)
    if (word & 0x3F007C00) == 0x08007C00:
        load = bool(word & (1 << 22))
        ordered_nonexclusive = bool(word & (1 << 23))
        rs = bits(word, 16, 5)
        if (not load and ordered_nonexclusive and rs != 31) or (load and rs != 31):
            return Decoded("unsupported-load-store-exclusive", UNSUPPORTED)
        return Decoded("load-store-exclusive", SUPPORTED)
    if (word & 0x1FE00000) == 0x1A400000:
        if bits(word, 10, 1):
            return Decoded("unsupported-conditional-compare", UNSUPPORTED)
        return Decoded("conditional-compare", SUPPORTED)
    if (word & 0x7F000000) == 0x1B000000:
        family = bits(word, 21, 3)
        is_64 = bool(word & (1 << 31))
        subtract = bool(word & (1 << 15))
        ra = bits(word, 10, 5)
        if family == 0 or (is_64 and family in (1, 5)):
            return Decoded("multiply-add-sub", SUPPORTED)
        if is_64 and family in (2, 6) and not subtract and ra == 31:
            return Decoded("multiply-add-sub", SUPPORTED)
        return Decoded("unsupported-multiply-add-sub", UNSUPPORTED)
    if (word & 0x5FE00000) == 0x1E200000:
        return Decoded("floating-point-data-processing", UNSUPPORTED)
    if (word & 0x1E000000) == 0x0E000000:
        return Decoded("simd", UNSUPPORTED)
    if (word & 0xFFE0001F) == 0xD4200000:
        return Decoded("unsupported-brk", UNSUPPORTED)
    return Decoded("unsupported-unknown", UNSUPPORTED)


def llvm_objdump_command(binary: Path) -> list[str]:
    direct = shutil.which("llvm-objdump")
    if direct:
        return [direct, "-d", str(binary)]
    xcrun = shutil.which("xcrun")
    if xcrun:
        return [xcrun, "llvm-objdump", "-d", str(binary)]
    return ["llvm-objdump", "-d", str(binary)]


def iter_instructions(binary: Path):
    command = llvm_objdump_command(binary)
    proc = subprocess.run(
        command,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    for line in proc.stdout.splitlines():
        match = INSTRUCTION_RE.match(line)
        if not match:
            continue
        yield int(match.group("pc"), 16), int(match.group("word"), 16), match.group("asm")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("binary", type=Path)
    parser.add_argument("--examples", type=int, default=12)
    args = parser.parse_args(argv)

    binary = args.binary
    if not binary.exists():
        print(f"error: binary not found: {binary}", file=sys.stderr)
        return 2

    counts: collections.Counter[str] = collections.Counter()
    unsupported_counts: collections.Counter[str] = collections.Counter()
    examples: dict[str, list[tuple[int, int, str]]] = collections.defaultdict(list)
    total = 0
    supported = 0

    for pc, word, asm in iter_instructions(binary):
        decoded = classify(word)
        total += 1
        counts[decoded.name] += 1
        if decoded.supported:
            supported += 1
        else:
            unsupported_counts[decoded.name] += 1
            if len(examples[decoded.name]) < args.examples:
                examples[decoded.name].append((pc, word, asm))

    print(f"# Orlix AArch64 Opcode Profile")
    print()
    print(f"binary: `{binary}`")
    print(f"instructions: {total}")
    print(f"supported_by_current_tcti_decode: {supported}")
    print(f"unsupported_by_current_tcti_decode: {total - supported}")
    print()
    print("| class | count | supported |")
    print("| --- | ---: | --- |")
    for name, count in counts.most_common():
        status = "no" if name in unsupported_counts else "yes"
        print(f"| `{name}` | {count} | {status} |")

    if unsupported_counts:
        print()
        print("## Unsupported Examples")
        for name, count in unsupported_counts.most_common():
            print()
            print(f"### {name} ({count})")
            for pc, word, asm in examples[name]:
                print(f"- `{pc:08x}: {word:08x}  {asm}`")

    return 1 if unsupported_counts else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
