def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    for command in ("audit", "write"):
        subparser = subparsers.add_parser(command)
        subparser.add_argument("--component", action="append", choices=DEFAULT_COMPONENTS)
        subparser.add_argument("--profile", default="release")
        subparser.add_argument("--repo-root", default=".")
        subparser.add_argument("--manifest-root", default="Build/orlix-build-manifests")
        subparser.add_argument("--stage", action="append")
    return parser.parse_args()


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def command_identity(command: list[str]) -> str:
    try:
        return subprocess.check_output(command, text=True, stderr=subprocess.STDOUT).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""


def run_git(repo_root: Path, args: list[str]) -> str:
    try:
        return subprocess.check_output(["git", *args], cwd=repo_root, text=True,
                                       stderr=subprocess.DEVNULL).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""


def iter_files(path: Path) -> Iterable[Path]:
    if path.is_file():
        yield path
        return
    if not path.exists() or not path.is_dir():
        return
    for root, dirs, files in os.walk(path):
        dirs[:] = sorted(d for d in dirs if d not in {".git", ".swiftpm", ".build", "__pycache__"})
        for name in sorted(files):
            candidate = Path(root) / name
            if candidate.is_file() and not candidate.is_symlink():
                yield candidate


def hash_path(repo_root: Path, relative: str) -> dict[str, object]:
    path = repo_root / relative
    entry: dict[str, object] = {"path": relative, "exists": path.exists()}
    if not path.exists():
        return entry
    if path.is_symlink():
        target = os.readlink(path)
        entry.update({"kind": "symlink", "target": target, "digest": sha256_bytes(target.encode())})
        return entry
    if path.is_file():
        data = path.read_bytes()
        entry.update({"kind": "file", "size": len(data), "digest": sha256_bytes(data)})
        return entry
    if path.is_dir():
        digest = hashlib.sha256()
        count = 0
        for file_path in iter_files(path):
            rel = file_path.relative_to(repo_root).as_posix()
            data_digest = sha256_bytes(file_path.read_bytes())
            digest.update(rel.encode())
            digest.update(b"\0")
            digest.update(data_digest.encode())
            digest.update(b"\0")
            count += 1
        entry.update({"kind": "directory", "file_count": count, "digest": digest.hexdigest()})
        return entry
    entry["kind"] = "other"
    return entry


def environment_identity(repo_root: Path, profile: str) -> dict[str, str]:
    return {
        "profile": profile,
        "platform": platform.platform(),
        "python": platform.python_version(),
        "xcode_version": command_identity(["xcodebuild", "-version"]),
        "clang_version": command_identity(["clang", "--version"]),
        "git_head": run_git(repo_root, ["rev-parse", "HEAD"]),
    }


def stage_manifest(repo_root: Path, component: str, stage: StageSpec, profile: str) -> dict[str, object]:
    payload: dict[str, object] = {
        "manifest_version": MANIFEST_VERSION,
        "component": component,
        "stage": stage.name,
        "profile": profile,
        "depends_on": list(stage.depends_on),
        "environment": environment_identity(repo_root, profile),
        "tool": hash_path(repo_root, MANIFEST_TOOL_PATH),
        "inputs": [hash_path(repo_root, path) for path in stage.inputs],
        "optional_inputs": [hash_path(repo_root, path) for path in stage.optional_inputs],
    }
    payload["input_digest"] = sha256_bytes(
        json.dumps(
            {
                "inputs": payload["inputs"],
                "optional_inputs": payload["optional_inputs"],
            },
            sort_keys=True,
            separators=(",", ":"),
        ).encode()
    )
    return payload


def manifest_path(repo_root: Path, manifest_root: Path, profile: str, component: str, stage: str) -> Path:
    root = manifest_root if manifest_root.is_absolute() else repo_root / manifest_root
    return root / profile / component / f"{stage}.json"


def load_manifest(path: Path) -> dict[str, object] | None:
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def stage_map(stages: tuple[StageSpec, ...]) -> dict[str, StageSpec]:
    return {stage.name: stage for stage in stages}


def validate_stage_graph(stages: tuple[StageSpec, ...]) -> list[str]:
    stages_by_name = stage_map(stages)
    diagnostics: list[str] = []
    for stage in stages_by_name.values():
        for dependency in stage.depends_on:
            if dependency not in stages_by_name:
                diagnostics.append(f"dependency-unknown {stage.name} {dependency}")

    visiting: set[str] = set()
    visited: set[str] = set()

    def visit(stage_name: str, path: tuple[str, ...]) -> None:
        if stage_name in visited:
            return
        if stage_name in visiting:
            cycle = path[path.index(stage_name) :] + (stage_name,)
            diagnostics.append(f"dependency-cycle {' '.join(cycle)}")
            return
        visiting.add(stage_name)
        stage = stages_by_name[stage_name]
        for dependency in stage.depends_on:
            if dependency in stages_by_name:
                visit(dependency, path + (dependency,))
        visiting.remove(stage_name)
        visited.add(stage_name)

    for stage_name in stages_by_name:
        visit(stage_name, (stage_name,))

    return diagnostics


def selected_components(args: argparse.Namespace) -> tuple[str, ...]:
    return tuple(dict.fromkeys(args.component)) if args.component else DEFAULT_COMPONENTS


def selected_stages(args: argparse.Namespace, component: str) -> tuple[StageSpec, ...]:
    stages = STAGES[component]
    if not args.stage:
        return stages
    wanted = set(args.stage)
    return tuple(stage for stage in stages if stage.name in wanted)


def selected_stage_diagnostics(args: argparse.Namespace, component: str) -> list[str]:
    if not args.stage:
        return []
    stage_names = {stage.name for stage in STAGES[component]}
    return [
        f"stage-unknown {component} {stage_name}"
        for stage_name in dict.fromkeys(args.stage)
        if stage_name not in stage_names
    ]


def freshness_environment(manifest: dict[str, object]) -> dict[str, object]:
    environment = manifest.get("environment")
    if not isinstance(environment, dict):
        return {}
    return {
        key: value
        for key, value in environment.items()
        if key not in FRESHNESS_IGNORED_ENVIRONMENT_KEYS
    }


def manifest_miss_reason(recorded: dict[str, object], current: dict[str, object]) -> str | None:
    if freshness_environment(recorded) != freshness_environment(current):
        return "environment-changed"
    for key in (
        "manifest_version",
        "depends_on",
        "tool",
        "input_digest",
        "inputs",
        "optional_inputs",
    ):
        if recorded.get(key) != current.get(key):
            return f"{key.replace('_', '-')}-changed"
    return None


def dependency_miss_reasons(
    repo_root: Path,
    manifest_root: Path,
    profile: str,
    component: str,
    stage: StageSpec,
) -> list[str]:
    stages = {candidate.name: candidate for candidate in STAGES[component]}
    misses: list[str] = []
    visiting: set[str] = set()

    def visit(owner: StageSpec) -> None:
        if owner.name in visiting:
            misses.append(f"dependency-cycle {owner.name}")
            return
        visiting.add(owner.name)
        for dependency in owner.depends_on:
            dependency_stage = stages.get(dependency)
            if dependency_stage is None:
                misses.append(f"dependency-unknown {dependency}")
                continue
            path = manifest_path(repo_root, manifest_root, profile, component, dependency)
            recorded = load_manifest(path)
            if not recorded:
                misses.append(f"dependency-missing {dependency} {path}")
                continue
            current = stage_manifest(repo_root, component, dependency_stage, profile)
            if reason := manifest_miss_reason(recorded, current):
                misses.append(f"dependency-stale {dependency} {reason} {path}")
                continue
            before = len(misses)
            visit(dependency_stage)
            for index in range(before, len(misses)):
                misses[index] = f"dependency-of {dependency} {misses[index]}"
        visiting.remove(owner.name)

    visit(stage)
    return misses


def audit(args: argparse.Namespace) -> int:
    repo_root = Path(args.repo_root).resolve()
    manifest_root = Path(args.manifest_root)
    failed = False
    for component in selected_components(args):
        graph_diagnostics = validate_stage_graph(STAGES[component])
        if graph_diagnostics:
            for diagnostic in graph_diagnostics:
                print(diagnostic)
            return 1
        stage_diagnostics = selected_stage_diagnostics(args, component)
        if stage_diagnostics:
            for diagnostic in stage_diagnostics:
                print(diagnostic)
            return 1
        for stage in selected_stages(args, component):
            current = stage_manifest(repo_root, component, stage, args.profile)
            path = manifest_path(repo_root, manifest_root, args.profile, component, stage.name)
            recorded = load_manifest(path)
            if not recorded:
                failed = True
                print(f"miss: {component}:{stage.name} manifest-missing {path}")
            elif reason := manifest_miss_reason(recorded, current):
                failed = True
                print(f"miss: {component}:{stage.name} {reason} {path}")
            elif dependency_misses := dependency_miss_reasons(repo_root, manifest_root, args.profile, component, stage):
                failed = True
                for reason in dependency_misses:
                    print(f"miss: {component}:{stage.name} {reason}")
            else:
                print(f"hit: {component}:{stage.name} {path}")
    return 1 if failed else 0


def write(args: argparse.Namespace) -> int:
    repo_root = Path(args.repo_root).resolve()
    manifest_root = Path(args.manifest_root)
    for component in selected_components(args):
        graph_diagnostics = validate_stage_graph(STAGES[component])
        if graph_diagnostics:
            for diagnostic in graph_diagnostics:
                print(diagnostic)
            return 1
        stage_diagnostics = selected_stage_diagnostics(args, component)
        if stage_diagnostics:
            for diagnostic in stage_diagnostics:
                print(diagnostic)
            return 1
        for stage in selected_stages(args, component):
            path = manifest_path(repo_root, manifest_root, args.profile, component, stage.name)
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(json.dumps(stage_manifest(repo_root, component, stage, args.profile),
                                       indent=2, sort_keys=True) + "\n")
            print(f"wrote: {component}:{stage.name} {path}")
    return 0


def main() -> int:
    args = parse_args()
    if args.command == "audit":
        return audit(args)
    if args.command == "write":
        return write(args)
    raise AssertionError(args.command)


if __name__ == "__main__":
    sys.exit(main())
